function talkHit(wx, wy, tol = 3) {
  const L = liveTalks();
  for (let i = L.length - 1; i &gt;= 0; i--) { const t = L[i]; if (wx &gt;= t.x - tol &amp;&amp; wx &lt;= t.x + t.w + tol &amp;&amp; wy &gt;= t.y - tol &amp;&amp; wy &lt;= t.y + t.h + tol) return t; }
