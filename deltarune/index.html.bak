var gmap={gb:[&#x27;body&#x27;,1],gr:[&#x27;barrel&#x27;,1],gl:[&#x27;len&#x27;,0],gs:[&#x27;size&#x27;,0],gf:[&#x27;rate&#x27;,0],gd:[&#x27;dmg&#x27;,0],gp:[&#x27;pellets&#x27;,0],gx:[&#x27;spread&#x27;,0],gmg:[&#x27;mag&#x27;,0],grl:[&#x27;reload&#x27;,0]};
Object.keys(gmap).forEach(function(id){E(id).addEventListener(&#x27;input&#x27;,function(){
  G[gmap[id][0]]=gmap[id][1]?E(id).value:parseFloat(E(id).value);applyGun();
})});
