const mHit = (x, y, w, h, fn) =&gt; menuHits.push({ x, y, w, h, fn });
function star(cx, cy, r) {
  ctx.fillStyle = &quot;#fff&quot;; ctx.beginPath();
  ctx.moveTo(cx, cy - r); ctx.lineTo(cx + r * .22, cy - r * .22); ctx.lineTo(cx + r, cy); ctx.lineTo(cx + r * .22, cy + r * .22);
  ctx.lineTo(cx, cy + r); ctx.lineTo(cx - r * .22, cy + r * .22); ctx.lineTo(cx - r, cy); ctx.lineTo(cx - r * .22, cy - r * .22); ctx.fill();
}
/* Original Deltarune textbox: sprites are loaded from the text/ folder.
