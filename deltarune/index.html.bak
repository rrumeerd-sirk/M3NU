&lt;body&gt;
&lt;canvas id=&quot;game&quot;&gt;&lt;/canvas&gt;
&lt;button id=&quot;bt&quot; type=&quot;button&quot;&gt;&lt;/button&gt;
&lt;button id=&quot;edBtn&quot; type=&quot;button&quot;&gt;bewerk&lt;/button&gt;
&lt;button id=&quot;musBtn&quot; type=&quot;button&quot;&gt;buster&lt;/button&gt;
&lt;button id=&quot;muteBtn&quot; type=&quot;button&quot;&gt;mute&lt;/button&gt;
&lt;div id=&quot;owStart&quot;&gt;&lt;div class=&quot;stt&quot;&gt;DeltaVile&lt;/div&gt;&lt;div class=&quot;sts&quot;&gt;A DELTARUNE fan game&lt;/div&gt;&lt;button type=&quot;button&quot; id=&quot;stNew&quot;&gt;NEW GAME (LOUD SONG)&lt;/button&gt;&lt;button type=&quot;button&quot; id=&quot;stLoad&quot;&gt;CONTINUE FROM SAVE&lt;/button&gt;&lt;div class=&quot;sti&quot; id=&quot;stInfo&quot;&gt;&lt;/div&gt;&lt;/div&gt;
&lt;div id=&quot;editor&quot;&gt;&lt;/div&gt;
&lt;button id=&quot;plBtn&quot; type=&quot;button&quot;&gt;playlist&lt;/button&gt;
&lt;div id=&quot;music&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;plist&quot; aria-hidden=&quot;true&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;credits&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;pad&quot; hidden&gt;
  &lt;div id=&quot;dpad&quot;&gt;&lt;i class=&quot;u&quot;&gt;&lt;/i&gt;&lt;i class=&quot;d&quot;&gt;&lt;/i&gt;&lt;i class=&quot;l&quot;&gt;&lt;/i&gt;&lt;i class=&quot;r&quot;&gt;&lt;/i&gt;&lt;/div&gt;
  &lt;div id=&quot;acts&quot;&gt;
    &lt;button id=&quot;bX&quot; type=&quot;button&quot;&gt;X&lt;/button&gt;
    &lt;button id=&quot;bT&quot; type=&quot;button&quot;&gt;T&lt;/button&gt;
    &lt;button id=&quot;bN&quot; type=&quot;button&quot;&gt;N&lt;/button&gt;
    &lt;button id=&quot;bA&quot; type=&quot;button&quot;&gt;A&lt;/button&gt;
  &lt;/div&gt;
&lt;/div&gt;
&lt;script&gt;

const DIALOOG = {
  up:    [&quot;* Doos 1.&quot;],
  left:  [&quot;* Doos 3.&quot;],
  right: [&quot;* Doos 4.&quot;],
  front: [&quot;* Doos 5.&quot;],
  back:  [&quot;* Doos 6.&quot;],
  alles: [&quot;* je hebt alles geinspecteerd&quot;]
};
const TYPSNELHEID = 0.6;

const SCALE = 3, SPR_W = 16, SPR_H = 30;
const ZOOM = 1.05;
const BASE_W = 400, BASE_H = 200;
const BATTLE_TIME = 15 * 60;
const ZW = 380, ZH = 380, HS = 40, PLEN = 720;

const canvas = document.getElementById(&quot;game&quot;);
canvas.width = BASE_W * SCALE;
canvas.height = BASE_H * SCALE;
const ctx = canvas.getContext(&quot;2d&quot;);
const ZX = (canvas.width - ZW) / 2, ZY = (canvas.height - ZH) / 2;
const FONT = &quot;undertale,&#x27;Courier New&#x27;,monospace&quot;;

const DMGSCALE = 4.5, INV_MAX = 12, LV_MAX = 20;
const ITEMDB = {
  candy:     { n: &quot;Dark Candy&quot;,      t: &quot;item&quot;,   heal: 40,  d: &quot;Heals 40 HP. Tastes like a dark rainbow.&quot; },
  cdiamond:  { n: &quot;Choco Diamond&quot;,   t: &quot;item&quot;,   heal: 60,  d: &quot;Heals 60 HP. Shiny and chewy.&quot; },
  revmint:   { n: &quot;ReviveMint&quot;,      t: &quot;item&quot;,   heal: 999, d: &quot;Heals all HP. Very minty.&quot; },
  woodblade: { n: &quot;Wood Blade&quot;,      t: &quot;weapon&quot;, atk: 2,     d: &quot;A wooden blade. Splinters included.&quot; },
  rustsword: { n: &quot;Rusty Sword&quot;,     t: &quot;weapon&quot;, atk: 4,     d: &quot;Rusty but trusty. Mostly rusty.&quot; },
  boxcutter: { n: &quot;Box Cutter&quot;,      t: &quot;weapon&quot;, atk: 6,     d: &quot;Made for inspecting boxes. Dangerously.&quot; },
  amber:     { n: &quot;Amber Card&quot;,      t: &quot;armor&quot;,  def: 2,     d: &quot;A warm amber card. Blocks a little.&quot; },
  cardboard: { n: &quot;Cardboard Vest&quot;,  t: &quot;armor&quot;,  def: 3,     d: &quot;Just a box with arm holes.&quot; },
  shackle:   { n: &quot;Iron Shackle&quot;,    t: &quot;armor&quot;,  def: 4, atk: 1, d: &quot;Heavy. Hits back a little.&quot; },
  phone:     { n: &quot;Cell Phone&quot;,      t: &quot;key&quot;,    d: &quot;Your phone. Use it to call people.&quot; },
  badge:     { n: &quot;Inspector Badge&quot;, t: &quot;key&quot;,    d: &quot;Proof that you inspect boxes. Officially.&quot; },
  boxkey:    { n: &quot;Box Key&quot;,         t: &quot;key&quot;,    d: &quot;It opens nothing. Yet.&quot; }
};
const LOOT = { up: &quot;candy&quot;, left: &quot;cdiamond&quot;, right: &quot;shackle&quot;, back: &quot;boxkey&quot;, front: &quot;badge&quot; };
const REWARD = { 1: { xp: 12, d: 10 }, 2: { xp: 20, d: 18 }, 3: { xp: 34, d: 30 }, 4: { xp: 70, d: 60 }, 5: { xp: 40, d: 35 }, 6: { xp: 40, d: 35 }, 7: { xp: 40, d: 35 } };
const GEAR = { 2: &quot;rustsword&quot;, 3: &quot;cardboard&quot;, 4: &quot;boxcutter&quot; };
const CONTACTS = [
  { n: &quot;Mom&quot;, lines: [&quot;* You called Mom.&quot;, &quot;* \&quot;Kris? Where are you?\&quot;&quot;, &quot;* \&quot;Dinner is at six. Don&#x27;t be late.\&quot;&quot;, &quot;* She hung up before you said a word.&quot;] },
  { n: &quot;Noelle&quot;, lines: [&quot;* You called Noelle.&quot;, &quot;* \&quot;H-hi Kris! Um... were you just calling&quot;, &quot;  to say hi?\&quot;&quot;, &quot;* \&quot;...Okay! Bye!\&quot;&quot;] },
  { n: &quot;Susie&quot;, lines: [&quot;* You called Susie.&quot;, &quot;* \&quot;WHAT.\&quot;&quot;, &quot;* \&quot;...You pocket-dialed me again, didn&#x27;t you.\&quot;&quot;, &quot;* (Click.)&quot;] },
  { n: &quot;Box Hotline&quot;, lines: [&quot;* You called the Box Hotline.&quot;, &quot;* \&quot;All boxes are currently being inspected.\&quot;&quot;, &quot;* \&quot;Please hold. A box will be with you shortly.\&quot;&quot;] }
];
const TITLES = [
  [1, &quot;Box Inspector&quot;, [&quot;Inspects all boxes&quot;, &quot;inexplicably.&quot;]],
  [4, &quot;Box Detective&quot;, [&quot;Opens every box and&quot;, &quot;finds nothing. Proudly.&quot;]],
  [8, &quot;Box Captain&quot;, [&quot;Leads inspections with&quot;, &quot;unearned confidence.&quot;]],
  [13, &quot;Box Legend&quot;, [&quot;Boxes fear this&quot;, &quot;inspector.&quot;]]
];

const newRpg = () =&gt; ({ lv: 1, xp: 0, hp: 90, maxHp: 90, money: 0, inv: [&quot;candy&quot;, &quot;candy&quot;], keys: [&quot;phone&quot;], bag: [], eq: { weapon: &quot;woodblade&quot;, a1: &quot;amber&quot;, a2: null }, looted: {}, wins: {}, shop: { bought: 0, sold: 0, tseen: 0 } });
let rpg = newRpg();
const xpNeed = lv =&gt; 30 + 20 * (lv - 1);
const baseStat = s =&gt; s === &quot;atk&quot; ? 9 + (rpg.lv - 1) : s === &quot;def&quot; ? 4 + ((rpg.lv - 1) &gt;&gt; 1) : ((rpg.lv - 1) / 3 | 0);
const eqStat = (s, eq = rpg.eq) =&gt; [&quot;weapon&quot;, &quot;a1&quot;, &quot;a2&quot;].reduce((a, k) =&gt; a + ((eq[k] &amp;&amp; ITEMDB[eq[k]][s]) || 0), 0);
const stat = (s, eq) =&gt; baseStat(s) + eqStat(s, eq);
const ownsGear = id =&gt; rpg.bag.includes(id) || Object.values(rpg.eq).includes(id);

function gainXp(n) {
  const ups = [];
  if (rpg.lv &gt;= LV_MAX) return ups;
  rpg.xp += n;
  while (rpg.lv &lt; LV_MAX &amp;&amp; rpg.xp &gt;= xpNeed(rpg.lv)) {
    rpg.xp -= xpNeed(rpg.lv); rpg.lv++; rpg.maxHp += 10; rpg.hp = Math.min(rpg.maxHp, rpg.hp + 10); ups.push(rpg.lv);
  }
  if (rpg.lv &gt;= LV_MAX) rpg.xp = 0;
  return ups;
}
function giveItem(id) {
  const T = ITEMDB[id].t;
  if (T === &quot;item&quot;) { if (rpg.inv.length &gt;= INV_MAX) return false; rpg.inv.push(id); }
  else if (T === &quot;key&quot;) { if (!rpg.keys.includes(id)) rpg.keys.push(id); }
  else rpg.bag.push(id);
  return true;
}
function winBattle(e) {
  if (!e) return;
  const T = etype(e), R = REWARD[T.id] || REWARD[1];
  rpg.money += R.d; rpg.wins = rpg.wins || {}; rpg.wins[T.id] = (rpg.wins[T.id] | 0) + 1; rpg.wins.any = (rpg.wins.any | 0) + 1;
  const sp = sparedWin; sparedWin = false; const ups = gainXp(sp ? 0 : R.xp), lines = [sp ? &quot;* You spared the enemy.&quot; : &quot;* YOU WON!&quot;, &quot;* You earned &quot; + (sp ? 0 : R.xp) + &quot; EXP and D$ &quot; + R.d + &quot;.&quot;];
