  E(&#x27;ged&#x27;).style.display=&#x27;none&#x27;;E(&#x27;oed&#x27;).style.display=&#x27;none&#x27;;
  gun.position.set(0.28,-0.26,-0.55);gun.rotation.y=0;drag=false;saveData();
