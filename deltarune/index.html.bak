function enemyFrame(e,dir,moving){
  var sp=e.userData.anim;if(!sp)return;
  var set=eList(dir);
  if(!set.length)set=eList(&#x27;down&#x27;).length?eList(&#x27;down&#x27;):eList(&#x27;up&#x27;).length?eList(&#x27;up&#x27;):eList(&#x27;left&#x27;).length?eList(&#x27;left&#x27;):eList(&#x27;right&#x27;);
  if(!set.length)return;
  var tex=set[moving?Math.floor(performance.now()/130+e.userData.ph*7)%set.length:0];
  if(sp.material.map!==tex){var had=!!sp.material.map;sp.material.map=tex;if(!had)sp.material.needsUpdate=true}
  sp.scale.set(2.6*tex.image.width/tex.image.height,2.6,1);
}
function krisUpdate(tp,eye){
  var on=krisOn&amp;&amp;tp&amp;&amp;state!==&#x27;menu&#x27;;krisSpr.visible=on;
  if(!on)return;
  krisSpr.renderOrder=view2d?Math.floor((eye.z+150)*20):0;krisSpr.material.depthTest=!view2d;
  avatar.visible=false;
  var f=(keys.KeyW||keys.ArrowUp?1:0)-(keys.KeyS||keys.ArrowDown?1:0)-jy,r=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0)+jx;
  var mv=Math.abs(f)+Math.abs(r)&gt;0.1,dir=f&lt;-0.1?&#x27;down&#x27;:r&lt;-0.1?&#x27;left&#x27;:r&gt;0.1?&#x27;right&#x27;:&#x27;up&#x27;;
  if(view2d){var ax=-Math.sin(yaw),az=-Math.cos(yaw);dir=Math.abs(ax)&gt;Math.abs(az)?(ax&lt;0?&#x27;left&#x27;:&#x27;right&#x27;):(az&lt;0?&#x27;up&#x27;:&#x27;down&#x27;)}
  var set=(krisSet[dir]||[]).filter(Boolean);
  if(!set.length)set=(krisSet.down||krisSet.up||krisSet.left||krisSet.right||[]).filter(Boolean);
  if(!set.length)return;
  var tex=set[mv?Math.floor(performance.now()/130)%set.length:0];
  if(krisSpr.material.map!==tex){krisSpr.material.map=tex;krisSpr.material.needsUpdate=true}
  var a=tex.image.width/tex.image.height;
  krisSpr.scale.set(1.9*a,1.9,1);
  krisSpr.position.set(eye.x,eye.y-1.6,eye.z-(view2d?eye.y-1.6:0));
}

function E(id){return document.getElementById(id)}
var edC=E(&#x27;map&#x27;),mode=&#x27;add&#x27;,sel=null,drag=false,edPrev=&#x27;menu&#x27;;
function hex(n){return &#x27;#&#x27;+(&#x27;000000&#x27;+n.toString(16)).slice(-6)}
function removeObs(o){scene.remove(o.mesh);var i=obstacles.indexOf(o);obstacles.splice(i,1);obsMeshes.splice(i,1)}
function clearObs(){while(obstacles.length)removeObs(obstacles[0]);sel=null}
function moveObs(o,x,z){o.x=x;o.z=z;o.x0=x-o.w/2;o.x1=x+o.w/2;o.z0=z-o.d/2;o.z1=z+o.d/2;o.mesh.position.x=x;o.mesh.position.z=z}
function saveData(){try{localStorage.setItem(&#x27;bpShooter&#x27;,JSON.stringify({W:W,obs:obstacles.filter(function(o){return o.kind===&#x27;box&#x27;}).map(function(o){return [o.x,o.z,o.w,o.h,o.d,o.c]})}))}catch(e){}}
function loadData(){try{var s=JSON.parse(localStorage.getItem(&#x27;bpShooter&#x27;)||&#x27;null&#x27;);if(!s)return;if(s.W)s.W.forEach(function(w,i){if(W[i])Object.assign(W[i],w)});clearObs();s.obs.forEach(function(a){boxObs(a[0],a[1],a[2],a[3],a[4],a[5])})}catch(e){}}
function sizeMap(){var s=Math.max(200,Math.min(innerWidth-24,innerHeight-250,520));edC.width=edC.height=s;edC.style.width=edC.style.height=s+&#x27;px&#x27;}
function draw(){
  var c=edC.getContext(&#x27;2d&#x27;),S=edC.width/200;
  c.fillStyle=&#x27;#6f757d&#x27;;c.fillRect(0,0,edC.width,edC.height);
  c.strokeStyle=&#x27;rgba(255,255,255,.15)&#x27;;c.lineWidth=1;
  for(var i=0;i&lt;=200;i+=20){c.beginPath();c.moveTo(i*S,0);c.lineTo(i*S,edC.height);c.moveTo(0,i*S);c.lineTo(edC.width,i*S);c.stroke()}
  obstacles.forEach(function(o){
    var X=(o.x0+100)*S,Z=(o.z0+100)*S,W=(o.x1-o.x0)*S,H=(o.z1-o.z0)*S;
    c.fillStyle=o.kind===&#x27;box&#x27;?hex(o.c):&#x27;#8a6fd0&#x27;;c.fillRect(X,Z,W,H);
    c.lineWidth=o===sel?3:1;c.strokeStyle=o===sel?&#x27;#fff&#x27;:&#x27;#000&#x27;;c.strokeRect(X,Z,W,H);
  });
  c.fillStyle=&#x27;#3b9dff&#x27;;c.beginPath();c.arc(100*S,100*S,5,0,6.3);c.fill();
}
function w2(e){var r=edC.getBoundingClientRect();return{x:Math.max(-LIM,Math.min(LIM,(e.clientX-r.left)/r.width*200-100)),z:Math.max(-LIM,Math.min(LIM,(e.clientY-r.top)/r.height*200-100))}}
function hitObs(p){for(var i=obstacles.length-1;i&gt;=0;i--){var o=obstacles[i];if(p.x&gt;=o.x0&amp;&amp;p.x&lt;=o.x1&amp;&amp;p.z&gt;=o.z0&amp;&amp;p.z&lt;=o.z1)return o}return null}
function boxVals(){return [+E(&#x27;wi&#x27;).value,+E(&#x27;hi&#x27;).value,+E(&#x27;di&#x27;).value,parseInt(E(&#x27;ci&#x27;).value.slice(1),16)]}
edC.addEventListener(&#x27;pointerdown&#x27;,function(e){
  var p=w2(e),v;
  if(mode===&#x27;add&#x27;){v=boxVals();boxObs(p.x,p.z,v[0],v[1],v[2],v[3]);sel=obstacles[obstacles.length-1];drag=true}
  else{
    var o=hitObs(p);
    if(mode===&#x27;del&#x27;){if(o)removeObs(o);sel=null}
    else{sel=o;drag=!!o;if(o&amp;&amp;o.kind===&#x27;box&#x27;){E(&#x27;wi&#x27;).value=o.w;E(&#x27;hi&#x27;).value=o.h;E(&#x27;di&#x27;).value=o.d;E(&#x27;ci&#x27;).value=hex(o.c)}}
  }
  edC.setPointerCapture(e.pointerId);draw();
});
edC.addEventListener(&#x27;pointermove&#x27;,function(e){if(drag&amp;&amp;sel){var p=w2(e);moveObs(sel,p.x,p.z);draw()}});
edC.addEventListener(&#x27;pointerup&#x27;,function(){drag=false});
[&#x27;wi&#x27;,&#x27;hi&#x27;,&#x27;di&#x27;,&#x27;ci&#x27;].forEach(function(id){E(id).addEventListener(&#x27;input&#x27;,function(){
  if(!sel||sel.kind!==&#x27;box&#x27;)return;
