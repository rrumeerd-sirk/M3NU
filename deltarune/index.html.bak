#editor{position:fixed;left:0;right:0;bottom:0;display:none;flex-direction:column;gap:6px;padding:8px max(8px,env(safe-area-inset-left)) max(8px,env(safe-area-inset-bottom));background:#000;border-top:4px solid #fff;z-index:6;user-select:none;-webkit-user-select:none;font:18px undertale,&quot;Courier New&quot;,monospace}
body.editing #editor{display:flex}
