&lt;body&gt;
&lt;canvas id=&quot;c&quot; width=&quot;480&quot; height=&quot;640&quot;&gt;&lt;/canvas&gt;
&lt;script&gt;
const c=document.getElementById(&#x27;c&#x27;),g=c.getContext(&#x27;2d&#x27;),W=480,H=640;
const COL=[&#x27;#ff4fd8&#x27;,&#x27;#4fe0ff&#x27;,&#x27;#ffe94f&#x27;,&#x27;#7dff6b&#x27;];
const KEYS={a:0,s:1,d:2,f:3,A:0,S:1,D:2,F:3};
const BPM=140,beat=60/BPM,LEAD=4*beat,FALL=1.4,HITY=540,LANE_W=88,X0=(W-LANE_W*4)/2,DUR=30;
let state=&#x27;idle&#x27;,ac,t0,notes=[],flash=[0,0,0,0],judge={t:&#x27;&#x27;,c:&#x27;#fff&#x27;,at:-9},pulse=0;

function rng(seed){return()=&gt;(seed=(seed*1664525+1013904223)%4294967296)/4294967296}
function makePattern(){
  const r=rng(7),out=[];let last=-1;
  for(let b=0;b&lt;=58;b+=0.5){
    const whole=Number.isInteger(b);
    if(whole||(b&gt;=8&amp;&amp;r()&lt;0.35)){
      let l;do{l=Math.floor(r()*4)}while(l===last&amp;&amp;r()&lt;0.7);
      last=l;out.push({lane:l,time:LEAD+b*beat,hit:false,done:false});
    }
  }
  return out;
}
function tone(f,t,d,type,v){
  const o=ac.createOscillator(),gn=ac.createGain();
  o.type=type;o.frequency.value=f;
  gn.gain.setValueAtTime(v,t);gn.gain.exponentialRampToValueAtTime(0.001,t+d);
  o.connect(gn).connect(ac.destination);o.start(t);o.stop(t+d+0.02);
}
function scheduleMusic(){
  const bass=[110,110,87.3,98],arp=[220,261.6,329.6,392,329.6,261.6];
  for(let i=0;i*beat&lt;DUR;i++){
    const t=t0+i*beat;
    tone(bass[Math.floor(i/4)%4],t,beat*0.9,&#x27;triangle&#x27;,0.28);
    tone(arp[i%6]*(i%8&lt;4?1:1.5),t,beat*0.4,&#x27;square&#x27;,0.05);
    tone(arp[(i+2)%6]*2,t+beat/2,beat*0.3,&#x27;square&#x27;,0.035);
    if(i%2===1)tone(60,t,0.12,&#x27;sine&#x27;,0.35);
  }
