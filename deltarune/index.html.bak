function addTalk() {
  const cx = editCamX + BASE_W / 2, cy = editCamY + BASE_H / 2;
  const t = { world: worldIdx, x: snapV(cx - 16), y: snapV(cy - 16), w: 32, h: 32, txt: TALK_DEFAULT, push: true, once: false, used: false, inside: false, id: newTalkId(), req: 0, gon: 0, give: null };
  clampT(t); TALKS.push(t); selT = t; saveLayout(); say(&quot;talk block &quot; + talkNr(t) + &quot; added: use &#x27;edit text&#x27; to change what it says&quot;);
