const PNL = { x: 150, y: 112, w: 900, h: 372 };
let menu = null, menuHits = [], lastTab = 0;

function openMenu() {
  ptr = null; player.moving = false; player.frame = 0;
  menu = { tab: lastTab, shown: false, focus: 0, st: &quot;cat&quot;, cat: 0, cur: 0, msg: null, ask: null, lk: &quot;0,0&quot;, rep: 0, t: 0, cands: [], slot: 0 };
}
function showTab(i) { setMenuTab(i); menu.shown = true; }
