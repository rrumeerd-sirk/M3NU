function addObstacle(mesh,x,z,w,h,d){
  mesh.position.x=x;mesh.position.z=z;scene.add(mesh);
  var o={x:x,z:z,w:w,d:d,x0:x-w/2,x1:x+w/2,z0:z-d/2,z1:z+d/2,h:h,mesh:mesh};obstacles.push(o);obsMeshes.push(mesh);return o;
}
function boxObs(x,z,w,h,d,c){
  var m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshLambertMaterial({color:c}));
  var ln=new THREE.LineSegments(new THREE.EdgesGeometry(m.geometry),new THREE.LineBasicMaterial({color:0x222222}));
  ln.raycast=function(){};m.add(ln);m.position.y=h/2;
  var o=addObstacle(m,x,z,w,h,d);o.kind=&#x27;box&#x27;;o.c=c;
}
function buildObstacles(){
  var s=7;function rnd(){s=(s*16807)%2147483647;return s/2147483647}
  var cols=[0xb98b4e,0x9aa1a8,0xd9822b,0x7d8f6a];
  for(var i=0;i&lt;28;i++){
    var x=(rnd()-0.5)*150,z=(rnd()-0.5)*150,t=i%4,c=cols[i%cols.length];
    if(Math.hypot(x,z)&lt;10)continue;
    if(t===0)boxObs(x,z,2,2,2,c);
    else if(t===1)boxObs(x,z,9,2.6,1.2,c);
    else if(t===2)boxObs(x,z,1.6,4.5,1.6,c);
    else boxObs(x,z,3.5,0.9,3.5,c);
  }
}
function pushOut(p,rad,feet){
  obstacles.forEach(function(o){
    if(feet&gt;=o.h-0.05)return;
    var cx=Math.max(o.x0,Math.min(p.x,o.x1)),cz=Math.max(o.z0,Math.min(p.z,o.z1));
    var dx=p.x-cx,dz=p.z-cz,d=Math.hypot(dx,dz);
    if(d&gt;=rad)return;
    if(d&gt;0.0001){p.x=cx+dx/d*rad;p.z=cz+dz/d*rad}
    else{
      var l=p.x-o.x0,r=o.x1-p.x,t=p.z-o.z0,b=o.z1-p.z,m=Math.min(l,r,t,b);
      if(m===l)p.x=o.x0-rad;else if(m===r)p.x=o.x1+rad;else if(m===t)p.z=o.z0-rad;else p.z=o.z1+rad;
    }
  });
}
function floorAt(x,z,feet){
  var f=0;
  obstacles.forEach(function(o){
    if(o.h&lt;=feet+0.05&amp;&amp;o.h&gt;f&amp;&amp;x&gt;o.x0-0.2&amp;&amp;x&lt;o.x1+0.2&amp;&amp;z&gt;o.z0-0.2&amp;&amp;z&lt;o.z1+0.2)f=o.h;
  });
  return f;
}
