const TB = { t: load(&quot;text/spr_textbox_top_0.png&quot;), l: load(&quot;text/spr_textbox_left_0.png&quot;), c: [] };
for (let i = 0; i &lt; 8; i++) TB.c.push(load(&quot;text/spr_textbox_topleft_&quot; + i + &quot;.png&quot;));
function tbox(x, y, w, h) {
  if (!(imgOk(TB.t) &amp;&amp; imgOk(TB.l) &amp;&amp; TB.c.every(imgOk))) return false;
  const S = 3, N = 16 * S, o = 4 * S, ox = x - o, oy = y - o, W = w + 2 * o, H = h + 2 * o;
  const c = TB.c[(performance.now() / 133 | 0) % 8];
  ctx.save(); ctx.imageSmoothingEnabled = false;
  ctx.fillStyle = &quot;#000&quot;; ctx.fillRect(x, y, w, h);
  const dr = (img, tx, ty, sx, sy, dx, dy, dw, dh) =&gt; { ctx.save(); ctx.translate(tx, ty); ctx.scale(sx, sy); ctx.drawImage(img, dx, dy, dw, dh); ctx.restore(); };
  dr(TB.t, ox, oy, 1, 1, N, 0, W - 2 * N, N);
  dr(TB.t, ox, oy + H, 1, -1, N, 0, W - 2 * N, N);
  dr(TB.l, ox, oy, 1, 1, 0, N, N, H - 2 * N);
  dr(TB.l, ox + W, oy, -1, 1, 0, N, N, H - 2 * N);
  dr(c, ox, oy, 1, 1, 0, 0, N, N);
  dr(c, ox + W, oy, -1, 1, 0, 0, N, N);
  dr(c, ox, oy + H, 1, -1, 0, 0, N, N);
  dr(c, ox + W, oy + H, -1, -1, 0, 0, N, N);
  ctx.restore();
