function start(){
  if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();
  ac.resume();
  notes=makePattern();
  t0=ac.currentTime+0.4;scheduleMusic();state=&#x27;play&#x27;;
}
function now(){return ac.currentTime-t0}
function press(l){
  if(state!==&#x27;play&#x27;)return;
  flash[l]=1;
  const s=now();let best=null;
  for(const n of notes)if(n.lane===l&amp;&amp;!n.done&amp;&amp;Math.abs(n.time-s)&lt;=0.16&amp;&amp;(!best||n.time&lt;best.time))best=n;
  if(!best){return}
  const d=Math.abs(best.time-s);best.done=true;best.hit=true;
  judge=d&lt;=0.07?{t:&#x27;PERFECT!&#x27;,c:&#x27;#fff&#x27;,at:s}:{t:&#x27;GOOD&#x27;,c:&#x27;#bbb&#x27;,at:s};
  tone(880+l*110,ac.currentTime,0.08,&#x27;square&#x27;,0.12);
}
addEventListener(&#x27;keydown&#x27;,e=&gt;{if(e.repeat)return;if(state===&#x27;menu&#x27;){if(performance.now()-menuAt&gt;400){e.preventDefault();flash=[0,0,0,0];judge.at=-9;start()}return}if(e.key in KEYS){e.preventDefault();press(KEYS[e.key])}else if(e.key===&#x27; &#x27;||e.key===&#x27;Enter&#x27;){if(state!==&#x27;play&#x27;)press(0)}});
c.addEventListener(&#x27;pointerdown&#x27;,e=&gt;{
  if(state===&#x27;menu&#x27;){if(performance.now()-menuAt&gt;400){flash=[0,0,0,0];judge.at=-9;start()}return}
  const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width*W;
  press(Math.max(0,Math.min(3,Math.floor((x-X0)/LANE_W))));
});
let endLock=0,menuAt=0;

function arrow(x,y,l,sz,fill,stroke){
  g.save();g.translate(x,y);g.rotate([Math.PI/2*3,0,Math.PI,Math.PI/2][l]*0+[ -Math.PI/2, 0, Math.PI, Math.PI/2 ][[1,0,2,3].indexOf(l)===-1?0:0]);
  g.restore();
  g.save();g.translate(x,y);
  g.rotate({0:Math.PI,1:-Math.PI/2,2:Math.PI/2,3:0}[l]);
  g.beginPath();g.moveTo(sz,0);g.lineTo(-sz*0.2,-sz);g.lineTo(-sz*0.2,-sz*0.4);g.lineTo(-sz,-sz*0.4);g.lineTo(-sz,sz*0.4);g.lineTo(-sz*0.2,sz*0.4);g.lineTo(-sz*0.2,sz);g.closePath();
  if(fill){g.fillStyle=fill;g.fill()}
  if(stroke){g.lineWidth=3;g.strokeStyle=stroke;g.stroke()}
  g.restore();
}
function heart(x,y,s,col){
  g.fillStyle=col;g.beginPath();
  g.moveTo(x,y+s*0.9);g.bezierCurveTo(x-s*1.6,y-s*0.2,x-s*0.6,y-s*1.1,x,y-s*0.35);
  g.bezierCurveTo(x+s*0.6,y-s*1.1,x+s*1.6,y-s*0.2,x,y+s*0.9);g.fill();
}
function text(t,x,y,sz,col,al){g.font=&#x27;bold &#x27;+sz+&#x27;px &quot;Courier New&quot;,monospace&#x27;;g.textAlign=al||&#x27;center&#x27;;g.fillStyle=col||&#x27;#fff&#x27;;g.fillText(t,x,y)}

function frame(){
  const s=state===&#x27;play&#x27;?now():0;
  g.fillStyle=&#x27;#000&#x27;;g.fillRect(0,0,W,H);
  for(let l=0;l&lt;4;l++){
    const x=X0+l*LANE_W;
    if(flash[l]&gt;0){g.fillStyle=&#x27;rgba(255,255,255,&#x27;+(flash[l]*0.25).toFixed(2)+&#x27;)&#x27;;g.fillRect(x,0,LANE_W,H);flash[l]=Math.max(0,flash[l]-0.08)}
    g.strokeStyle=&#x27;#555&#x27;;g.lineWidth=1;g.strokeRect(x,0,LANE_W,H);
    arrow(x+LANE_W/2,HITY,l,26,null,&#x27;#fff&#x27;);
    text([&#x27;A&#x27;,&#x27;S&#x27;,&#x27;D&#x27;,&#x27;F&#x27;][l],x+LANE_W/2,HITY+62,22,&#x27;#fff&#x27;);
  }
  if(state===&#x27;count&#x27;){
    const el=(performance.now()-menuAt)/1000;
    g.fillStyle=&#x27;rgba(0,0,0,.6)&#x27;;g.fillRect(0,0,W,H);
    text(String(Math.max(1,Math.ceil(3-el))),W/2,H/2+50,150,&#x27;#fff&#x27;);
    if(el&gt;=3){flash=[0,0,0,0];judge.at=-9;start()}
  }
  if(state===&#x27;play&#x27;){
    for(const n of notes){
      if(n.done)continue;
      const y=HITY-(n.time-s)/FALL*(HITY+20);
      if(y&lt;-40)continue;
      if(s-n.time&gt;0.16){n.done=true;judge={t:&#x27;MISS&#x27;,c:&#x27;#888&#x27;,at:s};continue}
      arrow(X0+n.lane*LANE_W+LANE_W/2,y,n.lane,26,COL[n.lane],&#x27;#fff&#x27;);
    }
    text(&#x27;TIME &#x27;+Math.max(0,Math.ceil(DUR-s)),W-14,30,18,&#x27;#fff&#x27;,&#x27;right&#x27;);
    g.fillStyle=&#x27;#444&#x27;;g.fillRect(14,100,W-28,8);g.fillStyle=&#x27;#fff&#x27;;g.fillRect(14,100,(W-28)*Math.min(1,s/DUR),8);
    if(s-judge.at&lt;0.5)text(judge.t,W/2,HITY-90,28,judge.c);
    if(s&gt;=DUR){
      state=&#x27;idle&#x27;;parent.postMessage(&#x27;rhythmDone&#x27;,&#x27;*&#x27;);
    }
  }
  if(state===&#x27;end&#x27;){
    g.fillStyle=&#x27;rgba(0,0,0,.82)&#x27;;g.fillRect(0,0,W,H);
    heart(W/2,200,28,&#x27;#fff&#x27;);
    text(&#x27;DONE!&#x27;,W/2,300,48,&#x27;#fff&#x27;);
    text(&#x27;Press to play again&#x27;,W/2,400,20,&#x27;#fff&#x27;);
  }
  requestAnimationFrame(frame);
}
addEventListener(&#x27;message&#x27;,e=&gt;{if(e.data&amp;&amp;e.data.type===&#x27;rhythmStart&#x27;&amp;&amp;state!==&#x27;play&#x27;){state=&#x27;count&#x27;;menuAt=performance.now();focus()}});
frame();
&lt;/script&gt;
&lt;/body&gt;
