#editor .row{display:flex;flex-wrap:wrap;gap:6px}
#editor button.on{border-color:#ff0;color:#ff0;background:#000}
#editor button,#edBtn{font:inherit;color:#fff;background:#000;border:3px solid #fff;border-radius:0;padding:4px 12px;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
#editor button:hover,#edBtn:hover{border-color:#ff0;color:#ff0}
