function prep(root,h){
  var b=new THREE.Box3().setFromObject(root),s=h/((b.max.y-b.min.y)||1);
  root.scale.multiplyScalar(s);
  b.setFromObject(root);
  var c=b.getCenter(new THREE.Vector3());
  root.position.x-=c.x;root.position.z-=c.z;root.position.y-=b.min.y;
  var g=new THREE.Group();g.add(root);return g;
}
function loadGLB(buf,done){
  new THREE.GLTFLoader().parse(buf,&#x27;&#x27;,function(gl){done(gl.scene)},function(){sprInfo.textContent=&#x27;Could not read that model. Export it as .glb without Draco compression.&#x27;});
}
function useEnemy(root){enemyModel=prep(root,2.4);sprInfo.textContent=&#x27;Enemy model loaded. New enemies will use it.&#x27;}
function useObstacle(root){
  var tpl=prep(root,2.6),b=new THREE.Box3().setFromObject(tpl),w=b.max.x-b.min.x,d=b.max.z-b.min.z;
  for(var i=0;i&lt;8;i++){
    var a=Math.random()*6.28,r=15+Math.random()*60;
    addObstacle(tpl.clone(true),Math.cos(a)*r,Math.sin(a)*r,w,2.6,d);
  }
  sprInfo.textContent=&#x27;Obstacle model placed 8 times around the baseplate.&#x27;;
}
function fileBuf(id,fn){
  document.getElementById(id).addEventListener(&#x27;change&#x27;,function(e){
    var f=e.target.files[0];if(!f)return;
    var rd=new FileReader();rd.onload=function(){loadGLB(rd.result,fn)};rd.readAsArrayBuffer(f);e.target.value=&#x27;&#x27;;
  });
}
fileBuf(&#x27;emodel&#x27;,useEnemy);fileBuf(&#x27;omodel&#x27;,useObstacle);
function usePlayer(root){
  while(avatar.children.length)avatar.remove(avatar.children[0]);
  var m=prep(root,1.9);m.rotation.y=Math.PI;avatar.add(m);
  sprInfo.textContent=&#x27;Player model loaded. Switch to third person with V to see it.&#x27;;
}
