<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DeltaVile</title>
<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}
iframe{position:fixed;inset:0;width:100%;height:100%;border:0}
#tm{position:fixed;top:10px;left:50%;transform:translateX(-50%);z-index:10;font:700 44px system-ui,sans-serif;color:#fff;text-shadow:3px 3px 0 #000;pointer-events:none;display:none}</style></head>
<body>
<div id="tm"></div>
<iframe id="g0" srcdoc="&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;utf-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no&quot;&gt;
&lt;title&gt;Baseplate Shooter&lt;/title&gt;
&lt;style&gt;
@font-face{font-family:undertale;src:local(&quot;Determination Mono&quot;),url(&quot;font/DTM-Mono.otf&quot;)}
:root{--ink:#f4f6f8;--hud:#0b1117cc;--accent:#ff5a3c;--pad:#ffffff30}
html,body{margin:0;height:100%;overflow:hidden;background:#9ad0ec;touch-action:none;font-family:&quot;Trebuchet MS&quot;,system-ui,sans-serif;color:var(--ink);user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
canvas{display:block}
#hud{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;display:flex;justify-content:space-between;padding:10px 14px;pointer-events:none;font-weight:700;font-size:18px}
#hud span{background:var(--hud);padding:6px 12px;border-radius:8px}
#cross{position:fixed;left:50%;top:50%;width:8px;height:8px;margin:-4px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px #0008;pointer-events:none}
#hurt{position:fixed;inset:0;background:radial-gradient(transparent 40%,#d00 120%);opacity:0;pointer-events:none;transition:opacity .25s}
#overlay{position:fixed;inset:0;background:#0b1117dd;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;gap:10px;cursor:pointer}
#overlay h1{margin:0;font-size:clamp(28px,7vw,52px);letter-spacing:.02em}
#overlay p{margin:0;max-width:420px;line-height:1.5;opacity:.85}
#overlay b{background:var(--accent);color:#fff;padding:12px 26px;border-radius:10px;font-size:20px;margin-top:8px}
#touch{display:none}
.btn{position:fixed;border-radius:50%;background:var(--pad);border:2px solid #ffffff80;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;touch-action:none}
#fire{right:calc(22px + env(safe-area-inset-right,0px));bottom:calc(34px + env(safe-area-inset-bottom,0px));width:96px;height:96px;background:#ff5a3c99}
#jump{right:calc(128px + env(safe-area-inset-right,0px));bottom:calc(24px + env(safe-area-inset-bottom,0px));width:72px;height:72px}
#sprint{right:calc(34px + env(safe-area-inset-right,0px));bottom:calc(146px + env(safe-area-inset-bottom,0px));width:70px;height:70px}
#view{top:calc(58px + env(safe-area-inset-top,0px));right:14px;width:auto;height:auto;padding:8px 14px;border-radius:10px;background:var(--hud)}
.pick{display:inline-block;background:#ffffff22;border:1px solid #ffffff66;padding:9px 16px;border-radius:10px;font-size:15px;margin:2px 4px;cursor:pointer}
#hud2{position:fixed;top:calc(52px + env(safe-area-inset-top,0px));left:14px;display:flex;flex-direction:column;gap:4px;pointer-events:none;font-weight:700;font-size:15px}
#hud2 span{background:var(--hud);padding:4px 10px;border-radius:8px;align-self:flex-start}
#healfx{position:fixed;inset:0;background:radial-gradient(transparent 40%,#2ecc71 130%);opacity:0;pointer-events:none;transition:opacity .3s}
.btn.on{background:#ffcf3acc;color:#000}
#reload{right:calc(128px + env(safe-area-inset-right,0px));bottom:calc(108px + env(safe-area-inset-bottom,0px));width:56px;height:56px;font-size:12px}
#wep,#tod{right:14px;width:auto;height:auto;padding:8px 14px;border-radius:10px;background:var(--hud)}
#wep{top:calc(104px + env(safe-area-inset-top,0px))}
#tod{top:calc(150px + env(safe-area-inset-top,0px))}
.panel{position:fixed;inset:0;background:#0b1117ee;display:none;flex-direction:column;align-items:center;gap:10px;padding:calc(10px + env(safe-area-inset-top,0px)) 12px calc(12px + env(safe-area-inset-bottom,0px));overflow:auto;touch-action:pan-y;z-index:5}
.panel.top{inset:0 0 auto 0;max-height:60vh;border-radius:0 0 14px 14px}
.row{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;width:100%;max-width:520px}
.panel button{background:#ffffff22;color:var(--ink);border:1px solid #ffffff66;border-radius:8px;padding:9px 16px;font:inherit}
.panel button.on{background:var(--accent);border-color:var(--accent)}
.panel label{display:flex;flex-direction:column;font-size:13px;gap:2px;min-width:120px;flex:1}
#map{touch-action:none;border-radius:8px}
#joy{position:fixed;width:120px;height:120px;margin:-60px 0 0 -60px;border-radius:50%;background:var(--pad);border:2px solid #ffffff60;display:none;pointer-events:none}
#knob{position:absolute;left:35px;top:35px;width:50px;height:50px;border-radius:50%;background:#ffffffaa}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;div id=&quot;hud&quot;&gt;&lt;span id=&quot;hp&quot;&gt;levens 100/100&lt;/span&gt;&lt;span id=&quot;sc&quot;&gt;Score 0&lt;/span&gt;&lt;/div&gt;
&lt;div id=&quot;cross&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;hud2&quot;&gt;&lt;span id=&quot;am&quot;&gt;&lt;/span&gt;&lt;span id=&quot;tm&quot;&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div id=&quot;hurt&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;healfx&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;touch&quot;&gt;&lt;div id=&quot;joy&quot;&gt;&lt;div id=&quot;knob&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;btn&quot; id=&quot;jump&quot;&gt;Jump&lt;/div&gt;&lt;div class=&quot;btn&quot; id=&quot;sprint&quot;&gt;Sprint&lt;/div&gt;&lt;div class=&quot;btn&quot; id=&quot;view&quot;&gt;View&lt;/div&gt;&lt;div class=&quot;btn&quot; id=&quot;reload&quot;&gt;Reload&lt;/div&gt;&lt;div class=&quot;btn&quot; id=&quot;wep&quot;&gt;Weapon&lt;/div&gt;&lt;div class=&quot;btn&quot; id=&quot;tod&quot;&gt;Time&lt;/div&gt;&lt;div class=&quot;btn&quot; id=&quot;fire&quot;&gt;Fire&lt;/div&gt;&lt;/div&gt;
&lt;div id=&quot;oed&quot; class=&quot;panel&quot;&gt;&lt;canvas id=&quot;map&quot;&gt;&lt;/canvas&gt;
&lt;div class=&quot;row&quot;&gt;&lt;button id=&quot;mAdd&quot; class=&quot;on&quot;&gt;Add&lt;/button&gt;&lt;button id=&quot;mMove&quot;&gt;Move&lt;/button&gt;&lt;button id=&quot;mDel&quot;&gt;Delete&lt;/button&gt;&lt;/div&gt;
&lt;div class=&quot;row&quot;&gt;&lt;label&gt;Width&lt;input type=&quot;range&quot; id=&quot;wi&quot; min=&quot;0.5&quot; max=&quot;12&quot; step=&quot;0.1&quot; value=&quot;2&quot;&gt;&lt;/label&gt;&lt;label&gt;Height&lt;input type=&quot;range&quot; id=&quot;hi&quot; min=&quot;0.3&quot; max=&quot;6&quot; step=&quot;0.1&quot; value=&quot;2&quot;&gt;&lt;/label&gt;&lt;label&gt;Depth&lt;input type=&quot;range&quot; id=&quot;di&quot; min=&quot;0.5&quot; max=&quot;12&quot; step=&quot;0.1&quot; value=&quot;2&quot;&gt;&lt;/label&gt;&lt;label&gt;Color&lt;input type=&quot;color&quot; id=&quot;ci&quot; value=&quot;#b98b4e&quot;&gt;&lt;/label&gt;&lt;/div&gt;
&lt;div class=&quot;row&quot;&gt;&lt;button id=&quot;oClr&quot;&gt;Clear all&lt;/button&gt;&lt;button id=&quot;oRst&quot;&gt;Reset&lt;/button&gt;&lt;button id=&quot;oDone&quot;&gt;Done&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;
&lt;div id=&quot;ged&quot; class=&quot;panel top&quot;&gt;&lt;div class=&quot;row&quot;&gt;&lt;button id=&quot;gPrev&quot;&gt;Previous&lt;/button&gt;&lt;b id=&quot;gName&quot;&gt;&lt;/b&gt;&lt;button id=&quot;gNext&quot;&gt;Next&lt;/button&gt;&lt;/div&gt;&lt;div class=&quot;row&quot;&gt;
&lt;label&gt;Body color&lt;input type=&quot;color&quot; id=&quot;gb&quot; value=&quot;#2b2f36&quot;&gt;&lt;/label&gt;&lt;label&gt;Barrel color&lt;input type=&quot;color&quot; id=&quot;gr&quot; value=&quot;#555c66&quot;&gt;&lt;/label&gt;
&lt;label&gt;Barrel length&lt;input type=&quot;range&quot; id=&quot;gl&quot; min=&quot;0.15&quot; max=&quot;0.9&quot; step=&quot;0.01&quot; value=&quot;0.35&quot;&gt;&lt;/label&gt;&lt;label&gt;Size&lt;input type=&quot;range&quot; id=&quot;gs&quot; min=&quot;0.7&quot; max=&quot;1.6&quot; step=&quot;0.05&quot; value=&quot;1&quot;&gt;&lt;/label&gt;
&lt;label&gt;Fire rate&lt;input type=&quot;range&quot; id=&quot;gf&quot; min=&quot;1&quot; max=&quot;16&quot; step=&quot;0.5&quot; value=&quot;6&quot;&gt;&lt;/label&gt;&lt;label&gt;Damage&lt;input type=&quot;range&quot; id=&quot;gd&quot; min=&quot;1&quot; max=&quot;6&quot; step=&quot;1&quot; value=&quot;1&quot;&gt;&lt;/label&gt;
&lt;label&gt;Pellets&lt;input type=&quot;range&quot; id=&quot;gp&quot; min=&quot;1&quot; max=&quot;8&quot; step=&quot;1&quot; value=&quot;1&quot;&gt;&lt;/label&gt;&lt;label&gt;Magazine&lt;input type=&quot;range&quot; id=&quot;gmg&quot; min=&quot;1&quot; max=&quot;60&quot; step=&quot;1&quot; value=&quot;12&quot;&gt;&lt;/label&gt;&lt;label&gt;Reload time&lt;input type=&quot;range&quot; id=&quot;grl&quot; min=&quot;0.3&quot; max=&quot;4&quot; step=&quot;0.1&quot; value=&quot;1.1&quot;&gt;&lt;/label&gt;&lt;label&gt;Spread&lt;input type=&quot;range&quot; id=&quot;gx&quot; min=&quot;0&quot; max=&quot;0.2&quot; step=&quot;0.01&quot; value=&quot;0&quot;&gt;&lt;/label&gt;&lt;/div&gt;
&lt;div class=&quot;row&quot;&gt;&lt;button id=&quot;gDone&quot;&gt;Done&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;
&lt;div id=&quot;help&quot; class=&quot;panel&quot;&gt;&lt;div class=&quot;row&quot; style=&quot;flex-direction:column;align-items:flex-start;line-height:1.5;font-size:15px&quot;&gt;
&lt;b&gt;Keys (computer)&lt;/b&gt;
&lt;div&gt;WASD move, Space jump, Shift hold to sprint, C toggle sprint&lt;br&gt;Mouse aim, click shoot, R reload, 1 to 5 or scroll switch weapon&lt;br&gt;V first or third person, N skip day and night, Esc pause&lt;/div&gt;
