    set(&quot;left&quot;, r.x / cur.nw * 100 + &quot;%&quot;); set(&quot;top&quot;, r.y / cur.nh * 100 + &quot;%&quot;); set(&quot;width&quot;, r.w / cur.nw * 100 + &quot;%&quot;);
  }
  function off() {
