function spawn(){
  var g=new THREE.Group(),animSp=null;
  if(enemyModel){
    var mm=enemyModel.clone(true);
    mm.traverse(function(o){if(o.material)o.material=o.material.clone()});
    g.add(mm);
  }else if(eOn){
    animSp=new THREE.Sprite(new THREE.SpriteMaterial({transparent:true}));
    animSp.center.set(0.5,0);animSp.scale.set(2.6,2.6,1);
    g.add(animSp);
  }else if(sprites.length){
    var s=sprites[Math.floor(Math.random()*sprites.length)];
    var sp=new THREE.Sprite(new THREE.SpriteMaterial({map:s.tex,transparent:true}));
    sp.center.set(0.5,0);sp.scale.set(2.6*s.aspect,2.6,1);
    g.add(sp);
  }else{
    var b=new THREE.Mesh(bodyGeo,new THREE.MeshLambertMaterial({color:0xd93a2b}));
    b.position.y=0.95;
    var h=new THREE.Mesh(headGeo,new THREE.MeshLambertMaterial({color:0xf2c27a}));
    h.position.y=2.0;
    h.userData.head=true;
    g.add(b,h);
  }
  g.userData={enemy:true,hp:3,flash:0,speed:2.5+Math.random()*1.5+Math.min(score*0.05,3),anim:animSp,ph:Math.random()*10};
  if(animSp)enemyFrame(g,&#x27;down&#x27;,false);
  var a=Math.random()*Math.PI*2,d=(view2d?17:30)+Math.random()*(view2d?8:20);
  g.position.set(Math.max(-LIM,Math.min(LIM,camera.position.x+Math.cos(a)*d)),0,Math.max(-LIM,Math.min(LIM,camera.position.z+Math.sin(a)*d)));
  pushOut(g.position,0.9,0);scene.add(g);enemies.push(g);
}
