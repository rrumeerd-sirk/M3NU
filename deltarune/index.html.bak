  if (g.k === &quot;item&quot; &amp;&amp; ITEMDB[g.v]) return { k: &quot;item&quot;, v: g.v };
  return null;
}
const reqLabel = r =&gt; !r ? &quot;always&quot; : r === 8 ? &quot;after any win&quot; : &quot;after beating &quot; + etype({ type: r }).name;
const giveLabel = t =&gt; !t.give ? &quot;none&quot; : t.give.k === &quot;money&quot; ? &quot;D$ &quot; + t.give.v : ITEMDB[t.give.v].n;
const gonLabel = t =&gt; t.gon ? &quot;answer &quot; + t.gon : &quot;any&quot;;
// a talk block with req &gt; 0 only works once you have won that fight (8 = any fight)
const talkOn = t =&gt; !t.req || ((rpg.wins &amp;&amp; (t.req === 8 ? rpg.wins.any : rpg.wins[t.req])) | 0) &gt; 0;
// text syntax: pages split with |  ·  1: to 5: speaker icon  ·  end a page with [Yes/No] for a choice  ·  1&gt; 2&gt; 3&gt; page only after that answer
function buildTalk(t) {
  const lines = [], ic = [], br = [], ch = [];
  for (let s of t.txt.split(&quot;|&quot;).map(x =&gt; x.trim()).filter(Boolean)) {
    let b = 0, w = t.who | 0, opts = null;
