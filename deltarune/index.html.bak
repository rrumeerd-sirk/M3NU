  ctx.beginPath(); ctx.moveTo(cx - s * .8, cy + s * .8); ctx.lineTo(cx + s * .8, cy - s * .8); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(cx - s * .5, cy + s * .1); ctx.lineTo(cx - s * .1, cy + s * .5); ctx.stroke(); ctx.lineCap = &quot;butt&quot;;
}
function shield(cx, cy, s, col) {
