  ctx.bezierCurveTo(cx + s * .2, cy - s * .5, cx + s * .95, cy - s * .1, cx + s * .7, cy + s * .5);
  ctx.bezierCurveTo(cx + s * .5, cy + s, cx - s * .5, cy + s, cx - s * .7, cy + s * .5);
