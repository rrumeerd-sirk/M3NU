&lt;style&gt;
@font-face{font-family:undertale;src:local(&quot;Determination Mono&quot;),url(&quot;font/DTM-Mono.otf&quot;)}
body{margin:0;background:#000;color:#fff;font-family:undertale,&quot;Courier New&quot;,monospace}
canvas{display:block;margin:auto;width:min(100vw,1200px);height:auto;image-rendering:pixelated;touch-action:none}
#pad{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:space-between;align-items:flex-end;padding:0 max(16px,env(safe-area-inset-right)) max(16px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left));pointer-events:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;touch-action:none;z-index:5}
