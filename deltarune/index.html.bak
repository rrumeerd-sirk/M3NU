const keys = {};
const K = (...n) =&gt; n.some(k =&gt; keys[k]);
let ptr = null;
addEventListener(&quot;keydown&quot;, e =&gt; {
  const k = e.key.toLowerCase();
  if (k.startsWith(&quot;arrow&quot;) || k === &quot; &quot;) e.preventDefault();
  if (!keys[k]) onPress(k);
  keys[k] = true;
});

addEventListener(&quot;keyup&quot;, e =&gt; keys[e.key.toLowerCase()] = false);
addEventListener(&quot;blur&quot;, () =&gt; { for (const k in keys) keys[k] = false; });
function pt(e) {
  const r = canvas.getBoundingClientRect();
  return { x: (e.clientX - r.left) * canvas.width / r.width, y: (e.clientY - r.top) * canvas.height / r.height };
}
canvas.addEventListener(&quot;pointerdown&quot;, e =&gt; { if (gameOverOn()) { leaveGameOver(); return; } if (battleMenuClick(pt(e))) return; const p = pt(e); if (menu) { menuClick(p); return; } if (mode === &quot;edit&quot;) { editDown(e, p); return; } if (mode === &quot;world&quot; &amp;&amp; clickWorld(p)) return; ptr = p; });
canvas.addEventListener(&quot;pointermove&quot;, e =&gt; { if (mode === &quot;edit&quot;) { editMove(pt(e)); return; } if (ptr) ptr = pt(e); });
addEventListener(&quot;pointerup&quot;, () =&gt; { if (mode === &quot;edit&quot;) editUp(); ptr = null; });

const pad = document.getElementById(&quot;pad&quot;), dpad = document.getElementById(&quot;dpad&quot;);
const bA = document.getElementById(&quot;bA&quot;), bN = document.getElementById(&quot;bN&quot;), bT = document.getElementById(&quot;bT&quot;), bX = document.getElementById(&quot;bX&quot;);
if (matchMedia(&quot;(pointer: coarse)&quot;).matches) pad.hidden = false;
addEventListener(&quot;pointerdown&quot;, e =&gt; { if (e.pointerType === &quot;touch&quot;) pad.hidden = false; });
pad.addEventListener(&quot;contextmenu&quot;, e =&gt; e.preventDefault());
const DIRS = { u: &quot;arrowup&quot;, d: &quot;arrowdown&quot;, l: &quot;arrowleft&quot;, r: &quot;arrowright&quot; };
function dpadSet(e) {
  const r = dpad.getBoundingClientRect();
  const x = (e.clientX - r.left - r.width / 2) / (r.width / 2), y = (e.clientY - r.top - r.height / 2) / (r.height / 2);
  const on = { l: x &lt; -0.3, r: x &gt; 0.3, u: y &lt; -0.3, d: y &gt; 0.3 };
  for (const d in DIRS) { keys[DIRS[d]] = on[d]; dpad.querySelector(&quot;.&quot; + d).classList.toggle(&quot;on&quot;, on[d]); }
}
function dpadOff() { for (const d in DIRS) { keys[DIRS[d]] = false; dpad.querySelector(&quot;.&quot; + d).classList.remove(&quot;on&quot;); } }
dpad.addEventListener(&quot;pointerdown&quot;, e =&gt; { e.preventDefault(); dpad.setPointerCapture(e.pointerId); dpadSet(e); });
dpad.addEventListener(&quot;pointermove&quot;, e =&gt; { if (dpad.hasPointerCapture(e.pointerId)) dpadSet(e); });
dpad.addEventListener(&quot;pointerup&quot;, dpadOff);
dpad.addEventListener(&quot;pointercancel&quot;, dpadOff);
function padBtn(id, key) {
  const b = document.getElementById(id), up = () =&gt; b.classList.remove(&quot;on&quot;);
  b.addEventListener(&quot;pointerdown&quot;, e =&gt; { e.preventDefault(); b.classList.add(&quot;on&quot;); onPress(key); });
  b.addEventListener(&quot;pointerup&quot;, up); b.addEventListener(&quot;pointercancel&quot;, up); b.addEventListener(&quot;pointerleave&quot;, up);
}
padBtn(&quot;bA&quot;, &quot;e&quot;); padBtn(&quot;bN&quot;, &quot;n&quot;); padBtn(&quot;bT&quot;, &quot;t&quot;); padBtn(&quot;bX&quot;, &quot;x&quot;);
let padMode = &quot;&quot;;
function padSync() {
  const pm = mode + (menu ? &quot;+menu&quot; : &quot;&quot;);
  if (pm === padMode) return;
  padMode = pm;
  muteBtn.style.display = menu ? &quot;none&quot; : &quot;&quot;;
  bT.style.display = mode === &quot;world&quot; &amp;&amp; !menu ? &quot;&quot; : &quot;none&quot;; bX.style.display = menu ? &quot;block&quot; : &quot;none&quot;;
  edBtn.style.display = (mode === &quot;world&quot; || mode === &quot;edit&quot;) &amp;&amp; !menu ? &quot;&quot; : &quot;none&quot;;
  edBtn.textContent = mode === &quot;edit&quot; ? &quot;speel&quot; : &quot;bewerk&quot;;
  musBtn.style.display = (mode === &quot;world&quot; || mode === &quot;edit&quot;) &amp;&amp; !menu ? &quot;&quot; : &quot;none&quot;;
  bN.style.display = mode === &quot;battle&quot; ? &quot;block&quot; : &quot;none&quot;;
  bA.style.display = mode === &quot;battle&quot; ? &quot;none&quot; : &quot;&quot;;
}

function vec(cx, cy) {
  let dx = (K(&quot;arrowright&quot;, &quot;d&quot;) ? 1 : 0) - (K(&quot;arrowleft&quot;, &quot;q&quot;, &quot;a&quot;) ? 1 : 0);
  let dy = (K(&quot;arrowdown&quot;, &quot;s&quot;) ? 1 : 0) - (K(&quot;arrowup&quot;, &quot;z&quot;, &quot;w&quot;) ? 1 : 0);
  if (!dx &amp;&amp; !dy &amp;&amp; ptr) {
    const vx = ptr.x - cx, vy = ptr.y - cy, d = Math.hypot(vx, vy);
    if (d &gt; 8) { dx = vx / d; dy = vy / d; }
  }
  return [dx, dy];
}

function load(src) { const img = new Image(); img.src = src; return img; }
const kris = {
  down:  [0, 1, 2, 3].map(i =&gt; load(&quot;kris/down_&quot; + i + &quot;.png&quot;)),
  left:  [0, 1].map(i =&gt; load(&quot;kris/left_&quot; + i + &quot;.png&quot;)),
  right: [0, 1].map(i =&gt; load(&quot;kris/right_&quot; + i + &quot;.png&quot;)),
  up:    [0, 1, 2, 3].map(i =&gt; load(&quot;kris/up_&quot; + i + &quot;.png&quot;))
};
const heartImg = load(&quot;data:image/png;base64,&quot;);

const player = { x: BASE_W / 2 - SPR_W / 2, y: BASE_H / 2 - SPR_H / 2, speed: 2, dir: &quot;down&quot;, frame: 0, timer: 0, moving: false };
let mode = &quot;world&quot;, tr = 0, fr = 0, bt = null;
let creditsOpen = false, crAudio = null, crRaf = 0, crOpenAt = 0, crY = 0, crLast = 0;
let worldIdx = 0, warp = null, posterLock = false;
const btn = document.getElementById(&quot;bt&quot;);
btn.onclick = () =&gt; { toggle(); btn.blur(); };

function sfx(n) { const a = new Audio(&quot;sounds/&quot; + n + &quot;.mp3&quot;); a.volume = musicVol; a.muted = muted; a.play().catch(() =&gt; {}); }
function toggle() {
  if (mode === &quot;edit&quot; || warp) return;
  if (mode === &quot;world&quot;) { mode = &quot;trans&quot;; tr = 0; dlg = null; owSync(); sfx(&quot;battle-start&quot;); }
  else {
    mode = &quot;world&quot;; ptr = null; stopMusic(); sfx(&quot;battle-end&quot;);
    if (fighting) fighting.alive = false;
    fighting = null; respawnEnemies();
  }
  btn.textContent = mode === &quot;world&quot; ? &quot;&quot; : &quot;&quot;;
}
let lastPat = -1;
function startBattle() {
  mode = &quot;battle&quot;;
  const T = fighting ? etype(fighting) : ETYPES[0]; if (T.rhythm) { mode = &quot;shooter&quot;; owSync(); parent.postMessage({ type: &quot;rhythm&quot; }, &quot;*&quot;); return; }
  if (T.mini) { mode = &quot;shooter&quot;; playTrack(trackFor(fighting)); owSync(); parent.postMessage({ type: &quot;mini&quot; }, &quot;*&quot;); return; }
  if (T.shooter) { mode = &quot;shooter&quot;; playTrack(trackFor(fighting)); owSync(); parent.postMessage({ type: &quot;arena&quot;, secs: T.time }, &quot;*&quot;); return; }
  bt = { hx: (ZW - HS) / 2, hy: ZH * 0.65, hp: rpg.hp, inv: 0, dead: 0, ph: 0, sel: 0, tp: 0, tc: 0, py: 0, wait: 0, def: false, pl: false, pr: false, txt: &quot;* &quot; + T.name + &quot; came sparkling into view!&quot;, pat: 0, pat2: -1, t: 0, tt: 0, acc: 0, pause: 60, auto: true, bul: [], left: T.time * 60, T };
  let pat;
  do pat = pickPat(); while (pat === lastPat &amp;&amp; T.pats.length &gt; 1);
  lastPat = pat; bt.pat = pat; bt.pat2 = pickPat2(); btInit();
  playTrack(trackFor(fighting));
}
const pickPat = () =&gt; bt.T.pats[Math.random() * bt.T.pats.length | 0];
function pickPat2() {
  if (!bt.T.combo) return -1;
  const p = bt.T.pats.filter(i =&gt; i !== bt.pat &amp;&amp; i !== 2);
  return p.length ? p[Math.random() * p.length | 0] : -1;
}
function setPat(n) { bt.pat = (n + PAT.length) % PAT.length; bt.t = 0; bt.tt = 0; bt.acc = 0; bt.g = undefined; bt.pause = 30; bt.bul = []; bt.pat2 = pickPat2(); }
function onPress(k) {
  if (gameOverOn()) { leaveGameOver(); return; }
  if (menu) { menuKey(k); return; }
  if (creditsOpen) { if (k === &quot;c&quot; || k === &quot;escape&quot;) closeCredits(); return; }
  if (shopOpen) { shopKey(k); return; }
  if (plOpen) { if (k === &quot;escape&quot;) togglePlaylist(); return; }
  if (dlg &amp;&amp; dlg.pick &amp;&amp; mode === &quot;world&quot;) {
    const n = dlg.ch[dlg.i].length;
    if (k === &quot;arrowleft&quot; || k === &quot;arrowup&quot; || k === &quot;a&quot; || k === &quot;q&quot; || k === &quot;w&quot; || k === &quot;z&quot;) { dlg.pick.sel = (dlg.pick.sel + n - 1) % n; goSnd(500, 0.04, &quot;square&quot;, 0.06); }
    else if (k === &quot;arrowright&quot; || k === &quot;arrowdown&quot; || k === &quot;d&quot; || k === &quot;s&quot;) { dlg.pick.sel = (dlg.pick.sel + 1) % n; goSnd(500, 0.04, &quot;square&quot;, 0.06); }
    else if (k === &quot;e&quot; || k === &quot;enter&quot; || k === &quot; &quot;) dlgChoose(dlg.pick.sel);
    return;
  }
  if (k === &quot;c&quot; &amp;&amp; mode === &quot;world&quot; &amp;&amp; !musicOpen &amp;&amp; !warp) { openCredits(); return; }
  if (k === &quot;i&quot; &amp;&amp; (mode === &quot;world&quot; || mode === &quot;edit&quot;)) { toggleMusic(); return; }
  if (musicOpen) { if (k === &quot;escape&quot;) toggleMusic(); return; }
  if (k === &quot;t&quot; &amp;&amp; mode === &quot;world&quot; &amp;&amp; !dlg &amp;&amp; !warp &amp;&amp; !startOpen) { openMenu(); return; }
  if (k === &quot;m&quot;) toggleEdit();
  if (mode === &quot;edit&quot;) { editKey(k); return; }
  if (k === &quot;b&quot;) toggle();
  if (mode === &quot;world&quot; &amp;&amp; (k === &quot;e&quot; || k === &quot;enter&quot; || k === &quot; &quot;)) act();
  if (mode !== &quot;battle&quot;) return;
  if (bt &amp;&amp; bt.ph !== 1 &amp;&amp; !bt.dead) { battleKey(k); return; }
  if (k &gt;= &quot;1&quot; &amp;&amp; k &lt;= &quot;7&quot;) { bt.auto = false; setPat(+k - 1); }
  if (k === &quot;n&quot;) { bt.auto = false; const p = bt.T.pats, i = p.indexOf(bt.pat); setPat(p[(i + 1) % p.length]); }
  if (k === &quot;0&quot;) bt.auto = true;
}


const IS = 24;
const SIDES = [
  { id: &quot;up&quot;,    name: &quot;bovenkant&quot;,   x: 188, y: 14,  col: &quot;#4a90e2&quot; },
  { id: &quot;left&quot;,  name: &quot;linkerkant&quot;,  x: 28,  y: 88,  col: &quot;#4ae27a&quot; },
  { id: &quot;right&quot;, name: &quot;rechterkant&quot;, x: 348, y: 88,  col: &quot;#e24a8a&quot; },
  { id: &quot;back&quot;,  name: &quot;achterkant&quot;,  x: 290, y: 36,  col: &quot;#9a4ae2&quot; },
  { id: &quot;front&quot;, name: &quot;voorkant&quot;,    x: 86,  y: 140, col: &quot;#e2e24a&quot; }
];
const SKIN_IDS = SIDES.map(s =&gt; s.id), skinImgs = {};
const skinImg = k =&gt; skinImgs[k] || (skinImgs[k] = load(&quot;box/&quot; + k + &quot;.png&quot;));
const skinCol = k =&gt; (SIDES.find(s =&gt; s.id === k) || {}).col || &quot;#888&quot;;
function makeItem(o) {
  const skin = SKIN_IDS.includes(o.skin) ? o.skin : &quot;up&quot;;
  return { id: o.id, skin, name: o.name || &quot;doos&quot;, x: o.x, y: o.y, world: o.world ? 1 : 0, lines: o.lines || null, reach: Number.isFinite(o.reach) ? Math.max(0, Math.min(200, o.reach)) : 8, col: skinCol(skin), img: skinImg(skin), pop: 0 };
}
const defaultItems = () =&gt; SIDES.map(s =&gt; makeItem({ id: s.id, skin: s.id, name: s.name, x: s.x, y: s.y, world: 0 }));
const ITEMS = defaultItems();
const liveItems = () =&gt; ITEMS.filter(i =&gt; i.world === worldIdx);
const seen = new Set();
let dlg = null;

const KRIS_HB_KEY = &quot;kris.hb.v1&quot;;
const KRIS_HB0 = { feet: { x: 2, y: 20, w: SPR_W - 4, h: SPR_H - 20 }, body: { x: 2, y: 8, w: SPR_W - 4, h: SPR_H - 8 } };
const KRIS_HB = { feet: { ...KRIS_HB0.feet }, body: { ...KRIS_HB0.body } };
try {
  const sv = JSON.parse(localStorage.getItem(KRIS_HB_KEY) || &quot;{}&quot;) || {};
  for (const k of [&quot;feet&quot;, &quot;body&quot;]) { const r = sv[k]; if (r &amp;&amp; [r.x, r.y, r.w, r.h].every(Number.isFinite) &amp;&amp; r.w &gt;= 1 &amp;&amp; r.h &gt;= 1) Object.assign(KRIS_HB[k], { x: r.x, y: r.y, w: r.w, h: r.h }); }
} catch (e) {}
const saveKrisHB = () =&gt; { try { localStorage.setItem(KRIS_HB_KEY, JSON.stringify(KRIS_HB)); } catch (e) {} };
const feetBox = (x = player.x, y = player.y) =&gt; ({ x: x + KRIS_HB.feet.x, y: y + KRIS_HB.feet.y, w: KRIS_HB.feet.w, h: KRIS_HB.feet.h });
const itemBox = it =&gt; ({ x: it.x, y: it.y, w: IS, h: IS });
const overlap = (a, b, m = 0) =&gt; a.x &lt; b.x + b.w + m &amp;&amp; a.x + a.w &gt; b.x - m &amp;&amp; a.y &lt; b.y + b.h + m &amp;&amp; a.y + a.h &gt; b.y - m;
const blocked = (x, y) =&gt; liveItems().some(it =&gt; overlap(feetBox(x, y), itemBox(it))) || solidRects().some(f =&gt; overlap(feetBox(x, y), f));
const reachOf = o =&gt; Number.isFinite(o.reach) ? o.reach : 8;
const hasReach = o =&gt; !!o &amp;&amp; !!(o.skin || o.t === &quot;sign&quot; || o.t === &quot;save&quot;);
const reachable = it =&gt; overlap(feetBox(), itemBox(it), reachOf(it));
function nearItem() {
  let best = null, bd = 1e9;
  const f = feetBox();
  for (const it of liveItems()) {
    if (!reachable(it)) continue;
    const d = Math.hypot(it.x + IS / 2 - (f.x + f.w / 2), it.y + IS / 2 - (f.y + f.h / 2));
    if (d &lt; bd) { bd = d; best = it; }
  }
  return best;
}
function openItem(it) {
  it.pop = 30; ptr = null;
  const f = feetBox(), vx = it.x + IS / 2 - (f.x + f.w / 2), vy = it.y + IS / 2 - (f.y + f.h / 2);
  player.dir = Math.abs(vx) &gt; Math.abs(vy) ? (vx &lt; 0 ? &quot;left&quot; : &quot;right&quot;) : (vy &lt; 0 ? &quot;up&quot; : &quot;down&quot;);
  player.frame = 0;
  const fill = t =&gt; String(t).replaceAll(&quot;{naam}&quot;, it.name).replaceAll(&quot;{pad}&quot;, &quot;box/&quot; + it.skin + &quot;.png&quot;);
  const lines = (it.lines || DIALOOG[it.id] || [&quot;* ...&quot;]).map(fill);
  lines.push(...lootFor(it));
  seen.add(it.id);
  if (!seen.done &amp;&amp; ITEMS.filter(b =&gt; !b.id.startsWith(&quot;field&quot;)).every(b =&gt; seen.has(b.id))) { seen.done = true; lines.push(...(DIALOOG.alles || []).map(fill)); }
  if (!lines.length) lines.push(&quot;* ...&quot;);
  dlg = { lines, i: 0, c: 0, top: (player.y + SPR_H / 2 - camY()) * zoom() &gt; BASE_H / 2 };
}
const SIGN_DEFAULT = &quot;A sign. It says nothing.|...Wait, there is a tiny note at the bottom.|It says: edit me in the room editor.&quot;;
const signs = () =&gt; objs.filter(o =&gt; o.t === &quot;sign&quot;);
const signBox = o =&gt; ({ x: o.x, y: o.y, w: OBJ_TYPES.sign.w, h: OBJ_TYPES.sign.h });
const nearSign = () =&gt; signs().find(o =&gt; overlap(feetBox(), signBox(o), reachOf(o)));
const saves = () =&gt; objs.filter(o =&gt; o.t === &quot;save&quot;);
const saveBox = o =&gt; ({ x: o.x, y: o.y, w: OBJ_TYPES.save.w, h: OBJ_TYPES.save.h });
const nearSave = () =&gt; saves().find(o =&gt; overlap(feetBox(), saveBox(o), reachOf(o)));
function openSave(o) {
  ptr = null;
  const f = feetBox(), T = OBJ_TYPES.save, vx = o.x + T.w / 2 - (f.x + f.w / 2), vy = o.y + T.h / 2 - (f.y + f.h / 2);
  player.dir = Math.abs(vx) &gt; Math.abs(vy) ? (vx &lt; 0 ? &quot;left&quot; : &quot;right&quot;) : (vy &lt; 0 ? &quot;up&quot; : &quot;down&quot;);
  player.frame = 0;
  rpg.hp = rpg.maxHp; const ok = saveGame();
  dlg = { lines: [&quot;* The shimmering light fills you with determination.&quot;, ok ? &quot;* (Game saved. HP fully restored.)&quot; : &quot;* (Couldn&#x27;t save: the browser blocks storage.)&quot;], i: 0, c: 0, top: (player.y + SPR_H / 2 - camY()) * zoom() &gt; BASE_H / 2 };
}
function openSign(o) {
  ptr = null;
  const f = feetBox(), vx = o.x + 9 - (f.x + f.w / 2), vy = o.y + 11 - (f.y + f.h / 2);
  player.dir = Math.abs(vx) &gt; Math.abs(vy) ? (vx &lt; 0 ? &quot;left&quot; : &quot;right&quot;) : (vy &lt; 0 ? &quot;up&quot; : &quot;down&quot;);
  player.frame = 0;
  const lines = (o.txt || SIGN_DEFAULT).split(&quot;|&quot;).map(t =&gt; t.trim()).filter(Boolean).map(t =&gt; t.startsWith(&quot;*&quot;) ? t : &quot;* &quot; + t);
  dlg = { lines: lines.length ? lines : [&quot;* ...&quot;], i: 0, c: 0, top: (player.y + SPR_H / 2 - camY()) * zoom() &gt; BASE_H / 2 };
}
function drawSignHint(o, w = OBJ_TYPES.sign.w) {
  const x = (o.x + w / 2) * SCALE, y = o.y * SCALE, b = cfg.vfx ? 0 : Math.sin(fr / 8) * 4;
}
// go to the next page; pages that belong to another answer (dlg.br) are skipped
function dlgAdvance() {
  do dlg.i++; while (dlg.i &lt; dlg.lines.length &amp;&amp; dlg.br &amp;&amp; dlg.br[dlg.i] &amp;&amp; dlg.br[dlg.i] !== dlg.pickd);
  if (dlg.i &gt;= dlg.lines.length) { const d = dlg; dlg = null; if (d.after) d.after(d.pickd | 0); }
  else dlg.c = 0;
}
function dlgChoose(n) { dlg.pickd = n + 1; dlg.pick = null; dlg.rects = null; goSnd(700, 0.08, &quot;square&quot;, 0.1, 900); dlgAdvance(); }
function act() {
  if (dlg) {
    if (dlg.c &lt; dlg.lines[dlg.i].length) dlg.c = dlg.lines[dlg.i].length;
    else if (dlg.ch &amp;&amp; dlg.ch[dlg.i]) { if (dlg.pick) dlgChoose(dlg.pick.sel); else dlg.pick = { sel: 0 }; }
    else dlgAdvance();
    return;
  }
  const it = nearItem();
  if (it) openItem(it);
  else if (nearSign()) openSign(nearSign());
  else if (nearSave()) openSave(nearSave());
  else if (nearShop()) toggleShop();
  else if (nearFollower()) talkFollower();
  else if (nearCredits()) openCredits();
  else if (nearPoster(8)) startWarp();
}
function clickWorld(p) {
  if (dlg) {
    if (dlg.pick &amp;&amp; dlg.rects) {
      const i = dlg.rects.findIndex(r =&gt; p.x &gt;= r.x &amp;&amp; p.x &lt;= r.x + r.w &amp;&amp; p.y &gt;= r.y &amp;&amp; p.y &lt;= r.y + r.h);
      if (i &gt;= 0) { if (dlg.pick.sel === i) dlgChoose(i); else dlg.pick.sel = i; return true; }
    }
    act(); return true;
  }
  const x = p.x / (SCALE * zoom()) + cam(), y = p.y / (SCALE * zoom()) + camY();
  const it = liveItems().find(i =&gt; x &gt;= i.x &amp;&amp; x &lt;= i.x + IS &amp;&amp; y &gt;= i.y &amp;&amp; y &lt;= i.y + IS);
  if (it &amp;&amp; reachable(it)) { openItem(it); return true; }
  const sg = signs().find(o =&gt; x &gt;= o.x &amp;&amp; x &lt;= o.x + OBJ_TYPES.sign.w &amp;&amp; y &gt;= o.y &amp;&amp; y &lt;= o.y + OBJ_TYPES.sign.h);
  if (sg &amp;&amp; overlap(feetBox(), signBox(sg), reachOf(sg))) { openSign(sg); return true; }
  const sv = saves().find(o =&gt; x &gt;= o.x &amp;&amp; x &lt;= o.x + OBJ_TYPES.save.w &amp;&amp; y &gt;= o.y &amp;&amp; y &lt;= o.y + OBJ_TYPES.save.h);
  if (sv &amp;&amp; overlap(feetBox(), saveBox(sv), reachOf(sv))) { openSave(sv); return true; }
  const po = posters().find(o =&gt; { const T = OBJ_TYPES[o.t]; return x &gt;= o.x &amp;&amp; x &lt;= o.x + T.w &amp;&amp; y &gt;= o.y &amp;&amp; y &lt;= o.y + T.h; });
  const cr = creditsObjs().find(o =&gt; x &gt;= o.x &amp;&amp; x &lt;= o.x + OBJ_TYPES.credits.w &amp;&amp; y &gt;= o.y &amp;&amp; y &lt;= o.y + OBJ_TYPES.credits.h + 22);
  if (cr &amp;&amp; overlap(feetBox(), creditsBox(cr), 6)) { openCredits(); return true; }
  if (po &amp;&amp; touchPoster(po, 8)) { startWarp(); return true; }
  return false;
}

const rnd = (a, b) =&gt; a + Math.random() * (b - a);
const orb = (x, y, vx, vy, r = 7) =&gt; bt.bul.push({ k: 0, x, y, vx: vx * bt.T.spd, vy: vy * bt.T.spd, r });
const rect = (x, y, w, h, vx, vy) =&gt; bt.bul.push({ k: 1, x, y, w, h, vx: vx * bt.T.spd, vy: vy * bt.T.spd });
const beam = (x, y, w, h) =&gt; bt.bul.push({ k: 2, x, y, w, h, age: bt.T.skip });
const hcx = () =&gt; bt.hx + HS / 2, hcy = () =&gt; bt.hy + HS / 2;
const clamp = (v, a, b) =&gt; Math.max(a, Math.min(b, v));
const PAT = [
  { n: &quot;Rain&quot;, f: t =&gt; { if (t % 6 === 0) orb(rnd(10, ZW - 10), -10, 0, 3 + rnd(0, 1.5) + t / 360); } },
  { n: &quot;Fan&quot;, f: t =&gt; {
    if (t % 4 === 0) { const a = Math.PI / 2 + Math.sin(t * .045) * 1.15; orb(ZW / 2, 0, Math.cos(a) * 3, Math.sin(a) * 3, 6); }
    if (t &gt; 300 &amp;&amp; t % 8 === 0) { const a = -Math.PI / 2 + Math.sin(t * .05) * 1.1; orb(ZW / 2, ZH, Math.cos(a) * 3, Math.sin(a) * 3, 6); }
  } },
  { n: &quot;Bones&quot;, f: t =&gt; {
    if (t % 72 === 20) {
      const L = (t / 72 | 0) % 2 === 0, gap = 100, gy = rnd(30, ZH - gap - 30), v = (L ? 1 : -1) * (3.2 + t / 360), x = L ? -16 : ZW;
      rect(x, 0, 16, gy, v, 0); rect(x, gy + gap, 16, ZH - gy - gap, v, 0);
    }
  } },
  { n: &quot;Aimed&quot;, f: t =&gt; {
    if (t % 38 === 0) {
      const s = Math.random() * 4 | 0, sx = s === 0 ? 0 : s === 1 ? ZW : rnd(0, ZW), sy = s === 2 ? 0 : s === 3 ? ZH : rnd(0, ZH);
      const a = Math.atan2(hcy() - sy, hcx() - sx);
      for (const d of [-.22, 0, .22]) orb(sx, sy, Math.cos(a + d) * 3.4, Math.sin(a + d) * 3.4, 7);
    }
  } },
  { n: &quot;Rude Buster&quot;, f: t =&gt; {
    if (t % 105 === 15) {
      const h = Math.random() &lt; .5, p = (h ? hcy() : hcx()) - 18 + rnd(-30, 30);
      if (h) beam(0, clamp(p, 0, ZH - 36), ZW, 36); else beam(clamp(p, 0, ZW - 36), 0, 36, ZH);
    }
  } },
  { n: &quot;Curtain&quot;, f: t =&gt; {
    if (t % 52 === 0) {
      const cols = Math.floor(ZW / 28), x0 = (ZW - cols * 28) / 2 + 14;
      bt.g = clamp((bt.g ?? 5) + Math.round(rnd(-4, 4)), 0, cols - 4);
      for (let i = 0; i &lt; cols; i++) if (i &lt; bt.g || i &gt;= bt.g + 4) orb(x0 + i * 28, -10, 0, 2.6, 8);
    }
  } },
  { n: &quot;Burst&quot;, f: t =&gt; {
    if (t % 58 === 0) {
      const x = rnd(80, ZW - 80), y = rnd(40, 160), o = Math.random() * 6.28;
      for (let i = 0; i &lt; 16; i++) { const a = o + i * Math.PI / 8; orb(x, y, Math.cos(a) * 2.2, Math.sin(a) * 2.2, 6); }
    }
  } }
];

function hit(b, cx, cy) {
  if (b.k === 0) return Math.hypot(b.x - cx, b.y - cy) &lt; b.r + 9;
  if (b.k === 2 &amp;&amp; !(b.age &gt;= 40 &amp;&amp; b.age &lt; 62)) return false;
  const nx = clamp(cx, b.x, b.x + b.w), ny = clamp(cy, b.y, b.y + b.h);
  return Math.hypot(nx - cx, ny - cy) &lt; 9;
}

const ETYPES = [
  { id: 1, name: &quot;gemene buster&quot;,     col: &quot;#6ee06e&quot;, speed: 0.7, chase: 0,   chaseSpeed: 0,   pats: [0, 1, 3],                spd: 0.8,  rate: 0.8,  dmg: 0.7, time: 12, skip: 0,  switch: 0,   combo: false },
  { id: 2, name: &quot;gemenere buster&quot;,    col: &quot;#e2e24a&quot;, speed: 0.9, chase: 0,   chaseSpeed: 0,   pats: [0, 1, 3, 5],             spd: 1.0,  rate: 1.0,  dmg: 1.0, time: 15, skip: 0,  switch: 0,   combo: false },
  { id: 3, name: &quot;onbeleefde buster&quot;, col: &quot;#f08a30&quot;, speed: 1.1, chase: 0,   chaseSpeed: 0,   pats: [0, 1, 2, 3, 4, 5],       spd: 1.2,  rate: 1.25, dmg: 1.3, time: 20, skip: 8,  switch: 420, combo: false },
  { id: 4, name: &quot;rakuichi en buster&quot;, col: &quot;#e02a3a&quot;, speed: 1.2, chase: 100, chaseSpeed: 1.4, pats: [0, 1, 2, 3, 4, 5, 6],    spd: 1.45, rate: 1.5,  dmg: 1.7, time: 30, skip: 16, switch: 360, combo: true },
