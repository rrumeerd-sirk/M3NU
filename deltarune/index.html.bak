  edPrev=state;state=which;overlay.style.display=&#x27;none&#x27;;
  if(which===&#x27;gun&#x27;){E(&#x27;ged&#x27;).style.display=&#x27;flex&#x27;;gun.position.set(0,-0.12,-0.7);
    syncGun();applyGun()}
  else{E(&#x27;oed&#x27;).style.display=&#x27;flex&#x27;;sizeMap();draw()}
}
