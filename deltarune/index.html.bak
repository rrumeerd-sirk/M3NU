const MENU_DIRS = { arrowright: [1, 0], d: [1, 0], arrowleft: [-1, 0], a: [-1, 0], q: [-1, 0], arrowdown: [0, 1], s: [0, 1], arrowup: [0, -1], w: [0, -1], z: [0, -1] };
function menuKey(k) {
  if (k === &quot;p&quot; &amp;&amp; MENU_TABS[menu.tab] === &quot;POWER&quot;) { menuChar = (menuChar + 1) % 3; return; }
