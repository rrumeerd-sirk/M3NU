    list = u.searchParams.get(&quot;list&quot;) || &quot;&quot;;
    if (h === &quot;youtu.be&quot;) v = u.pathname.split(&quot;/&quot;)[1] || &quot;&quot;;
    else if (h === &quot;youtube.com&quot; || h === &quot;youtube-nocookie.com&quot;) {
