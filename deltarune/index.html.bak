    if (canvas.parentNode === stage) { document.body.insertBefore(bgVid, document.body.firstChild); document.body.insertBefore(canvas, bgVid.nextSibling); }
    [&quot;left&quot;, &quot;top&quot;, &quot;width&quot;].forEach(k =&gt; canvas.style.removeProperty(k));
    if (layer) { layer.remove(); layer = null; }
  }
  function put(c) {
    if (layer) layer.remove();
    layer = c.layer; layer.className = &quot;blayer&quot;; layer.style.zIndex = c.over ? &quot;3&quot; : &quot;0&quot;;
    cur = { nw: c.nw, nh: c.nh, rect: c.rect }; stage.insertBefore(layer, stage.firstChild);
    if (canvas.parentNode !== stage) { stage.appendChild(bgVid); stage.appendChild(canvas); }
    stage.style.display = &quot;block&quot;; layout();
  }
  function show(i) {
