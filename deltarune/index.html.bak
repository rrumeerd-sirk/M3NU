const talkNr = t =&gt; TALKS.indexOf(t) + 1;
function resetTalks() { for (const t of TALKS) { t.used = false; t.inside = false; } for (const k in rpg.looted) if (k.startsWith(&quot;t_&quot;)) delete rpg.looted[k]; talkSafe = null; }
function clampT(t) { t.w = clamp(t.w, 8, MAX_ROOM); t.h = clamp(t.h, 8, MAX_ROOM); t.x = clamp(t.x, -LIMIT, LIMIT - t.w); t.y = clamp(t.y, -LIMIT, LIMIT - t.h); }
function updateTalks() {
