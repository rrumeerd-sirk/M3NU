    ctx.strokeStyle = &quot;#fff&quot;; ctx.lineWidth = 6; ctx.strokeRect(x + 3, y + 3, w - 6, h - 6);
    for (const [cx, cy] of [[x + 3, y + 3], [x + w - 3, y + 3], [x + 3, y + h - 3], [x + w - 3, y + h - 3]]) star(cx, cy, 15);
  }
  if (title) { ctx.font = &quot;30px &quot; + FONT; const tw = ctx.measureText(title).width + 28; ctx.fillStyle = &quot;#000&quot;; ctx.fillRect(x + w / 2 - tw / 2, y - 2, tw, 12); text(title, x + w / 2, y - 14, 30, &quot;#fff&quot;, &quot;center&quot;); }
}
