#acts{display:flex;align-items:flex-end;gap:14px}
#acts button{width:68px;height:68px;border-radius:50%;padding:0;background:rgba(255,255,255,.08);border:2px solid rgba(255,255,255,.5);color:#fff;font:inherit;font-size:26px;touch-action:none;-webkit-tap-highlight-color:transparent}
