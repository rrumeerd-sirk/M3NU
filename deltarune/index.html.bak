  ctx.fillStyle = &quot;#0a0820&quot;; ctx.fillRect(x, y, w, h);
  ctx.fillStyle = on ? &quot;#2a3a8a&quot; : &quot;#3a52c8&quot;; ctx.fillRect(x + 4, y + 4 + d, w - 8, h - 8 - d);
  ctx.fillStyle = on ? &quot;#1d2a66&quot; : &quot;#6d86ff&quot;; ctx.fillRect(x + 4, y + 4 + d, w - 8, 5);
  ctx.strokeStyle = on ? &quot;#7cffa0&quot; : &quot;#a9b8ff&quot;; ctx.lineWidth = 3; ctx.strokeRect(x + 4, y + 4 + d, w - 8, h - 8 - d);
  if (p.order) text(String(i + 1), x + w / 2, y + h / 2 - 8 + d, 18, on ? &quot;#7cffa0&quot; : &quot;#fff&quot;, &quot;center&quot;);
