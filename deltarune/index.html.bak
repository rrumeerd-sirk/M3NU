function updAmmo(){E(&#x27;am&#x27;).textContent=G.name+&#x27; &#x27;+(reloadT&gt;0?&#x27;Reloading…&#x27;:G.ammo+&#x27; / &#x27;+G.mag);E(&#x27;wep&#x27;).textContent=G.name}
function setWeapon(i){wi=(i+W.length)%W.length;G=W[wi];reloadT=0;cool=0.2;applyGun();E(&#x27;gName&#x27;).textContent=G.name}
function startReload(){if(reloadT&gt;0||G.ammo&gt;=G.mag)return;reloadT=G.reload;updAmmo()}
function syncGun(){Object.keys(gmap).forEach(function(id){E(id).value=G[gmap[id][0]]});E(&#x27;gName&#x27;).textContent=G.name}
E(&#x27;gPrev&#x27;).addEventListener(&#x27;click&#x27;,function(){setWeapon(wi-1);syncGun()});
E(&#x27;gNext&#x27;).addEventListener(&#x27;click&#x27;,function(){setWeapon(wi+1);syncGun()});

var healfx=document.getElementById(&#x27;healfx&#x27;);
function spawnHeal(x,z){
  var g=new THREE.Group();
  var box=new THREE.Mesh(new THREE.BoxGeometry(0.7,0.5,0.7),new THREE.MeshLambertMaterial({color:0xffffff,emissive:0x444444}));
  var rm=new THREE.MeshLambertMaterial({color:0xe02424,emissive:0x660000});
  var c1=new THREE.Mesh(new THREE.BoxGeometry(0.4,0.14,0.72),rm),c2=new THREE.Mesh(new THREE.BoxGeometry(0.14,0.4,0.72),rm);
  g.add(box,c1,c2);
  g.position.set(Math.max(-LIM,Math.min(LIM,x)),0.8,Math.max(-LIM,Math.min(LIM,z)));
  pushOut(g.position,0.9,0);
  g.userData={bob:Math.random()*6};
  scene.add(g);heals.push(g);
}
E(&#x27;hBtn&#x27;).addEventListener(&#x27;click&#x27;,function(){E(&#x27;help&#x27;).style.display=&#x27;flex&#x27;});
E(&#x27;hDone&#x27;).addEventListener(&#x27;click&#x27;,function(){E(&#x27;help&#x27;).style.display=&#x27;none&#x27;});

addEventListener(&#x27;keydown&#x27;,function(e){
  keys[e.code]=true;if(e.code===&#x27;Space&#x27;)e.preventDefault();
  if(e.code===&#x27;KeyV&#x27;)cycleView();
  if(e.code===&#x27;KeyR&#x27;)startReload();
  if(e.code===&#x27;KeyN&#x27;)skipTime();
  if(e.code===&#x27;KeyC&#x27;){sprintOn=!sprintOn;E(&#x27;sprint&#x27;).classList.toggle(&#x27;on&#x27;,sprintOn)}
  var n=e.code.indexOf(&#x27;Digit&#x27;)===0?parseInt(e.code.slice(5),10):0;
  if(n&gt;=1&amp;&amp;n&lt;=W.length)setWeapon(n-1);
});
addEventListener(&#x27;wheel&#x27;,function(e){if(state===&#x27;play&#x27;)setWeapon(wi+(e.deltaY&gt;0?1:-1))});
addEventListener(&#x27;keyup&#x27;,function(e){keys[e.code]=false});
addEventListener(&#x27;mousemove&#x27;,function(e){
  if(document.pointerLockElement!==cv)return;
  if(view2d){cur2.x=Math.max(0,Math.min(innerWidth,cur2.x+e.movementX));cur2.y=Math.max(0,Math.min(innerHeight,cur2.y+e.movementY));cursorOn=true;return}
  yaw-=e.movementX*0.0022;
  pitch=Math.max(-1.45,Math.min(1.45,pitch-e.movementY*0.0022));
});
cv.addEventListener(&#x27;mousedown&#x27;,function(){if(state===&#x27;play&#x27;)fireHeld=true});
addEventListener(&#x27;mouseup&#x27;,function(){fireHeld=false});
addEventListener(&#x27;contextmenu&#x27;,function(e){e.preventDefault()});

var jx=0,jy=0,joyId=null,lookId=null,lastX=0,lastY=0,ox=0,oy=0,jumpReq=false;
var joyEl=document.getElementById(&#x27;joy&#x27;),knob=document.getElementById(&#x27;knob&#x27;);
var fireId=null;
function tStart(e){
  if(state!==&#x27;play&#x27;)return;
  for(var i=0;i&lt;e.changedTouches.length;i++){
    var t=e.changedTouches[i],id=t.target.id;
    if(id===&#x27;fire&#x27;){fireHeld=true;fireId=t.identifier}
    else if(id===&#x27;jump&#x27;){jumpReq=true}
    else if(id===&#x27;sprint&#x27;){sprintOn=!sprintOn;E(&#x27;sprint&#x27;).classList.toggle(&#x27;on&#x27;,sprintOn)}
    else if(id===&#x27;view&#x27;){cycleView()}
    else if(id===&#x27;reload&#x27;){startReload()}
    else if(id===&#x27;wep&#x27;){setWeapon(wi+1)}
    else if(id===&#x27;tod&#x27;){skipTime()}
    else if(t.clientX&lt;innerWidth/2&amp;&amp;joyId===null){
      joyId=t.identifier;ox=t.clientX;oy=t.clientY;
      joyEl.style.display=&#x27;block&#x27;;joyEl.style.left=ox+&#x27;px&#x27;;joyEl.style.top=oy+&#x27;px&#x27;;
    }else if(lookId===null){lookId=t.identifier;lastX=t.clientX;lastY=t.clientY}
  }
  e.preventDefault();
}
function tMove(e){
  for(var i=0;i&lt;e.changedTouches.length;i++){
    var t=e.changedTouches[i];
    if(t.identifier===joyId){
      var dx=t.clientX-ox,dy=t.clientY-oy,l=Math.hypot(dx,dy),m=50;
      if(l&gt;m){dx=dx/l*m;dy=dy/l*m}
      jx=dx/m;jy=dy/m;
      knob.style.transform=&#x27;translate(&#x27;+dx+&#x27;px,&#x27;+dy+&#x27;px)&#x27;;
    }else if(t.identifier===lookId){
      cursorOn=false;yaw-=(t.clientX-lastX)*0.0055;
      pitch=Math.max(-1.45,Math.min(1.45,pitch-(t.clientY-lastY)*0.0055));
      lastX=t.clientX;lastY=t.clientY;
    }
  }
  e.preventDefault();
}
function tEnd(e){
  for(var i=0;i&lt;e.changedTouches.length;i++){
    var id=e.changedTouches[i].identifier;
    if(id===joyId){joyId=null;jx=jy=0;joyEl.style.display=&#x27;none&#x27;;knob.style.transform=&#x27;none&#x27;}
    if(id===lookId)lookId=null;
    if(id===fireId){fireId=null;fireHeld=false}
    if(id===sprintId){sprintId=null;sprintHeld=false}
  }
}
document.addEventListener(&#x27;touchstart&#x27;,tStart,{passive:false});
document.addEventListener(&#x27;touchmove&#x27;,tMove,{passive:false});
document.addEventListener(&#x27;touchend&#x27;,tEnd);
document.addEventListener(&#x27;touchcancel&#x27;,tEnd);

function shoot(){
  cool=1/G.rate;recoil=0.07;flashT=0.04;flash.visible=true;
  G.ammo--;updAmmo();if(G.ammo&lt;=0)startReload();
  for(var i=0;i&lt;G.pellets;i++)pellet((Math.random()-0.5)*2*G.spread,(Math.random()-0.5)*2*G.spread);
}
function hurtEnemy(o,dmg){
  o.userData.hp-=dmg;o.userData.flash=0.08;setFlash(o,0xffffff);
  if(o.userData.hp&lt;=0){
    scene.remove(o);enemies.splice(enemies.indexOf(o),1);
    score++;scEl.textContent=&#x27;Score &#x27;+score;
    if(Math.random()&lt;0.2)spawnHeal(o.position.x,o.position.z);
  }
}
function pellet(ox,oy){
  if(view2d){
    var a=yaw+ox*0.8,dx=-Math.sin(a),dz=-Math.cos(a),px=camera.position.x,pz=camera.position.z,py=camera.position.y-0.6;
    ray.set(rayO.set(px,py,pz),rayD.set(dx,0,dz));
    var wall=ray.intersectObjects(obsMeshes,true),bt=Math.min(40,wall.length?wall[0].distance:40),best=null;
    enemies.forEach(function(e){
      var ex=e.position.x-px,ez=e.position.z-pz,t=ex*dx+ez*dz;
      if(t&lt;0||t&gt;bt)return;
      if(Math.abs(ex*dz-ez*dx)&lt;0.9){best=e;bt=t}
    });
    var p=tr.geometry.attributes.position;p.setXYZ(0,px,py,pz);p.setXYZ(1,px+dx*bt,py,pz+dz*bt);p.needsUpdate=true;tr.visible=true;trT=0.06;
    if(best)hurtEnemy(best,G.dmg);
    return;
  }
  ray.setFromCamera({x:ox,y:oy},camera);
  var hits=ray.intersectObjects(enemies,true);
  var wall=ray.intersectObjects(obsMeshes,true);
  if(hits.length&amp;&amp;wall.length&amp;&amp;wall[0].distance&lt;hits[0].distance)return;
  if(!hits.length)return;
  var o=hits[0].object,dmg=(o.userData.head?2:1)*G.dmg;
  while(o&amp;&amp;!o.userData.enemy)o=o.parent;
  if(!o)return;
  hurtEnemy(o,dmg);
}

var clock=new THREE.Clock();
function loop(){
  requestAnimationFrame(loop);
  var rawDt=clock.getDelta(),dt=Math.min(rawDt,0.05);adapt(rawDt);
  if(state===&#x27;play&#x27;){
    var f=(keys.KeyW||keys.ArrowUp?1:0)-(keys.KeyS||keys.ArrowDown?1:0)-jy;
    var r=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0)+jx;
    var l=Math.hypot(f,r);if(l&gt;1){f/=l;r/=l}
    if(view2d&amp;&amp;cursorOn){var pv=pivot2(),adx=cur2.x-pv.x,ady=cur2.y-pv.y;if(Math.abs(adx)+Math.abs(ady)&gt;2)yaw=Math.atan2(-adx,-ady)}
    var my=view2d?0:yaw,sy=Math.sin(my),cy=Math.cos(my);
    var sprint=(keys.ShiftLeft||keys.ShiftRight||sprintHeld||sprintOn)&amp;&amp;f&gt;0.1,spd=sprint?12:7;
    camera.position.x+=(-sy*f+cy*r)*spd*dt;
    camera.position.z+=(-cy*f-sy*r)*spd*dt;
    camera.position.x=Math.max(-LIM,Math.min(LIM,camera.position.x));
    camera.position.z=Math.max(-LIM,Math.min(LIM,camera.position.z));
    pushOut(camera.position,0.45,camera.position.y-1.6);
    if((keys.Space||jumpReq)&amp;&amp;ground){vy=8.5;ground=false}
    jumpReq=false;
    var pf=camera.position.y-1.6;
    vy-=24*dt;camera.position.y+=vy*dt;
    var fl=floorAt(camera.position.x,camera.position.z,pf),ft=camera.position.y-1.6;
    if(ft&lt;=fl&amp;&amp;vy&lt;=0){camera.position.y=fl+1.6;vy=0;ground=true}else if(ft&gt;fl+0.02)ground=false;
    camera.rotation.y=yaw;camera.rotation.x=pitch;
    fov+=((sprint?85:75)-fov)*Math.min(1,dt*8);camera.fov=fov;camera.updateProjectionMatrix();

    cool-=dt;
    dayT=(dayT+dt/240)%1;applyTime();stars.position.copy(camera.position);
    if(reloadT&gt;0){reloadT-=dt;if(reloadT&lt;=0){reloadT=0;G.ammo=G.mag;updAmmo()}}
    else if(fireHeld&amp;&amp;cool&lt;=0){if(G.ammo&gt;0)shoot();else startReload()}
    gun.rotation.x+=((reloadT&gt;0?-0.8:0)-gun.rotation.x)*Math.min(1,dt*10);
    recoil=Math.max(0,recoil-dt*0.5);
    gun.position.z=-0.55+recoil;
    if(flashT&gt;0){flashT-=dt;if(flashT&lt;=0)flash.visible=false}
    if(trT&gt;0){trT-=dt;if(trT&lt;=0)tr.visible=false}

    spawnT-=dt;
    if(spawnT&lt;=0&amp;&amp;enemies.length&lt;6+Math.floor(score/4)){spawn();spawnT=Math.max(0.7,2.2-score*0.04)}

    hurtCd-=dt;
    healT-=dt;
    if(healT&lt;=0&amp;&amp;heals.length&lt;3){var ha=Math.random()*6.283,hr=10+Math.random()*30;spawnHeal(camera.position.x+Math.cos(ha)*hr,camera.position.z+Math.sin(ha)*hr);healT=14}
    var tnow=performance.now()/1000;
    for(var hi=heals.length-1;hi&gt;=0;hi--){
      var hk=heals[hi];hk.rotation.y+=dt*2;hk.position.y=0.8+Math.sin(tnow*3+hk.userData.bob)*0.12;
      if(hp&lt;100&amp;&amp;camera.position.y&lt;3&amp;&amp;Math.hypot(hk.position.x-camera.position.x,hk.position.z-camera.position.z)&lt;1.3){
        hp=Math.min(100,hp+35);hpEl.textContent=&#x27;Health &#x27;+hp;
        scene.remove(hk);heals.splice(hi,1);
        healfx.style.opacity=1;setTimeout(function(){healfx.style.opacity=0},180);
      }
    }
    enemies.forEach(function(e){
      var dx=camera.position.x-e.position.x,dz=camera.position.z-e.position.z,d=Math.hypot(dx,dz);
      if(d&gt;1.4){e.position.x+=dx/d*e.userData.speed*dt;e.position.z+=dz/d*e.userData.speed*dt}
      else if(hurtCd&lt;=0&amp;&amp;camera.position.y&lt;2.6){
        hp-=10;hurtCd=0.6;hpEl.textContent=&#x27;Health &#x27;+Math.max(0,hp);
        hurt.style.opacity=1;setTimeout(function(){hurt.style.opacity=0},150);
      }
      var bx=e.position.x,bz=e.position.z;pushOut(e.position,0.6,0);
      if(d&gt;0.01&amp;&amp;Math.abs(e.position.x-bx)+Math.abs(e.position.z-bz)&gt;0.0005){e.position.x+=-dz/d*e.userData.speed*dt;e.position.z+=dx/d*e.userData.speed*dt}
      e.rotation.y=Math.atan2(dx,dz);
      var vyaw=view2d?0:yaw,ux=d&gt;0.01?dx/d:0,uz=d&gt;0.01?dz/d:0,vf=-ux*Math.sin(vyaw)-uz*Math.cos(vyaw),vr=ux*Math.cos(vyaw)-uz*Math.sin(vyaw);
      if(e.userData.anim)enemyFrame(e,Math.abs(vr)&gt;Math.abs(vf)?(vr&lt;0?&#x27;left&#x27;:&#x27;right&#x27;):(vf&lt;0?&#x27;down&#x27;:&#x27;up&#x27;),d&gt;1.4);
      if(view2d||e.userData.v2){e.traverse(function(o){if(o.isSprite){o.renderOrder=view2d?Math.floor((e.position.z+150)*20):0;o.material.depthTest=!view2d}});e.userData.v2=view2d}
      if(e.userData.flash&gt;0){e.userData.flash-=dt;if(e.userData.flash&lt;=0)setFlash(e,0)}
    });
    if(hp&lt;=0){
      state=&#x27;dead&#x27;;fireHeld=false;hp=0;hpEl.textContent=&#x27;Health 0&#x27;;
      if(document.exitPointerLock)document.exitPointerLock();
      ttl.textContent=&#x27;You were overrun&#x27;;msg.textContent=&#x27;Final score: &#x27;+score+&#x27;. Jump over enemies to dodge their hits.&#x27;;goBtn.textContent=&#x27;Play again&#x27;;
      var wasArena=arenaOn;
      if(wasArena)parent.postMessage(&#x27;arenaDead&#x27;,&#x27;*&#x27;);
      showGameOver(function(){
        if(wasArena)parent.postMessage(&#x27;arenaContinue&#x27;,&#x27;*&#x27;);
        else setTimeout(function(){overlay.style.display=&#x27;flex&#x27;},300);
      });
    }
  }
  var eye=eyeV.copy(camera.position);
  var tp=thirdP&amp;&amp;state!==&#x27;gun&#x27;;
  if(state===&#x27;gun&#x27;)gun.rotation.y+=0.015;
  avatar.visible=tp&amp;&amp;state!==&#x27;menu&#x27;;gun.visible=!tp;
  avatar.position.set(eye.x,eye.y-1.6,eye.z);avatar.rotation.y=yaw;
  krisUpdate(tp,eye);
  if(tp&amp;&amp;!view2d){
    var dir=dirV.set(0,0,-1).applyEuler(camera.rotation);
    camera.position.copy(eye).addScaledVector(dir,-4);
    camera.position.y=Math.max(0.4,camera.position.y+0.5);
  }
  if(scene.fog){scene.fog.near=view2d?9000:40;scene.fog.far=view2d?9500:150}
  if(view2d&amp;&amp;cursorOn&amp;&amp;(cur2.x!==lcx||cur2.y!==lcy)){lcx=cur2.x;lcy=cur2.y;crossEl.style.left=lcx+&#x27;px&#x27;;crossEl.style.top=lcy+&#x27;px&#x27;}
  if(view2d&amp;&amp;state!==&#x27;gun&#x27;){cam2Update(eye);renderer.render(scene,cam2)}
  else renderer.render(scene,camera);
  camera.position.copy(eye);
}
addEventListener(&#x27;resize&#x27;,function(){
  camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);
});
var gac;
function gsnd(f,d,type,v,slide){try{gac=gac||new (window.AudioContext||window.webkitAudioContext)();var o=gac.createOscillator(),gn=gac.createGain(),t=gac.currentTime;o.type=type;o.frequency.setValueAtTime(f,t);if(slide)o.frequency.exponentialRampToValueAtTime(slide,t+d);gn.gain.setValueAtTime(v,t);gn.gain.exponentialRampToValueAtTime(0.001,t+d);o.connect(gn).connect(gac.destination);o.start(t);o.stop(t+d+0.02)}catch(e){}}
function showGameOver(done){
  var cvs=document.createElement(&#x27;canvas&#x27;);
  cvs.style.cssText=&#x27;position:fixed;left:0;top:0;width:100%;height:100%;z-index:200;cursor:pointer;touch-action:manipulation&#x27;;
  document.body.appendChild(cvs);
  var dpr=Math.min(2,window.devicePixelRatio||1),W=cvs.width=Math.round(innerWidth*dpr),H=cvs.height=Math.round(innerHeight*dpr),g=cvs.getContext(&#x27;2d&#x27;);
  var S=Math.round(Math.min(W,H)*0.09),hx=W/2-S/2,hy=H*0.5-S/2,go=0,shards=null,acc=0,last=performance.now(),raf=0,finished=false,READY=260;
  function heart(x,y,s){g.beginPath();g.moveTo(x+s/2,y+s*0.95);g.bezierCurveTo(x-s*0.35,y+s*0.45,x+s*0.1,y-s*0.2,x+s/2,y+s*0.3);g.bezierCurveTo(x+s*0.9,y-s*0.2,x+s*1.35,y+s*0.45,x+s/2,y+s*0.95);g.closePath();g.fill()}
  function half(side){var P=[[.5,-.2],[.42,.2],[.58,.45],[.44,.7],[.5,1.2]],ex=side&lt;0?-2:3;g.beginPath();g.moveTo(hx+ex*S,hy-.2*S);P.forEach(function(p){g.lineTo(hx+p[0]*S,hy+p[1]*S)});g.lineTo(hx+ex*S,hy+1.2*S);g.closePath()}
  function step(){
    go++;
    if(go===60)gsnd(300,0.12,&#x27;square&#x27;,0.15,120);
    if(go===110){shards=[];for(var i=0;i&lt;8;i++)shards.push({x:W/2+(Math.random()-.5)*S*.6,y:H*.5+(Math.random()-.5)*S*.6,vx:(Math.random()-.5)*6*dpr,vy:(-Math.random()*4-1)*dpr,r:Math.random()*6,vr:(Math.random()-.5)*.3});gsnd(900,0.5,&#x27;sawtooth&#x27;,0.12,60)}
    if(shards)shards.forEach(function(q){q.x+=q.vx;q.y+=q.vy;q.vy+=.3*dpr;q.r+=q.vr});
  }
  function draw(){
    g.clearRect(0,0,W,H);
    g.fillStyle=&#x27;rgba(0,0,0,&#x27;+Math.min(1,go/50)+&#x27;)&#x27;;g.fillRect(0,0,W,H);
    g.fillStyle=&#x27;#f00&#x27;;
    if(go&lt;60){g.globalAlpha=Math.min(1,go/15);heart(hx,hy,S);g.globalAlpha=1}
    else if(go&lt;110){[-1,1].forEach(function(side){g.save();half(side);g.clip();heart(hx+side*3*dpr,hy+(side&gt;0?2*dpr:0),S);g.restore()})}
    else if(shards){g.save();g.globalAlpha=Math.max(0,1-(go-110)/90);var u=S*0.17;shards.forEach(function(q){g.save();g.translate(q.x,q.y);g.rotate(q.r);g.beginPath();g.moveTo(-u,u);g.lineTo(u,u);g.lineTo(0,-u*1.3);g.fill();g.restore()});g.restore()}
    g.textAlign=&#x27;center&#x27;;g.textBaseline=&#x27;middle&#x27;;g.fillStyle=&#x27;#fff&#x27;;
    g.globalAlpha=Math.min(1,Math.max(0,(go-170)/90));
    g.font=Math.round(Math.min(W/8,H/5))+&quot;px undertale,&#x27;Courier New&#x27;,monospace&quot;;g.fillText(&#x27;GAME OVER&#x27;,W/2,H*0.4);
    if(go&gt;=READY){g.globalAlpha=0.55+0.45*Math.sin(go/14);g.fillStyle=&#x27;#aaa&#x27;;g.font=Math.round(Math.min(W/30,H/18))+&quot;px undertale,&#x27;Courier New&#x27;,monospace&quot;;g.fillText(&#x27;press any key / tap to continue&#x27;,W/2,H*0.62)}
    g.globalAlpha=1;
  }
  function loopGO(n){
    if(finished)return;
    acc+=Math.min(100,n-last);last=n;
    while(acc&gt;=1000/60){step();acc-=1000/60}
    draw();raf=requestAnimationFrame(loopGO);
  }
  function finish(e){
    if(go&lt;READY||finished)return;
    if(e){e.preventDefault();e.stopPropagation()}
    finished=true;cancelAnimationFrame(raf);
    removeEventListener(&#x27;keydown&#x27;,finish,true);removeEventListener(&#x27;pointerdown&#x27;,finish,true);
