  const fl = { x: snapV(cx - w / 2), y: snapV(cy - h / 2 + 20), w, h };
  const pl = [-1, 0, 1].map(i =&gt; ({ x: snapV(cx - PLATE / 2 + i * 36), y: snapV(cy - 50), w: PLATE, h: PLATE }));
  const p = initPuzzle({ world: worldIdx, plates: pl, floor: fl });
