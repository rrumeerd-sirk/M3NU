    ic.push(w); br.push(b); ch.push(opts); lines.push(s.startsWith(&quot;*&quot;) ? s : &quot;* &quot; + s);
  }
  if (!lines.length) { lines.push(&quot;* ...&quot;); ic.push(0); br.push(0); ch.push(null); }
