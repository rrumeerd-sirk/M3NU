  if (label) { ctx.font = &quot;24px &quot; + FONT; const tw = ctx.measureText(label).width + 24; ctx.fillStyle = &quot;#000&quot;; ctx.fillRect(lx - tw / 2, y - 6, tw, 12); text(label, lx, y - 12, 24, &quot;#fff&quot;, &quot;center&quot;); }
}
function mHeart(x, y, s = 28) { ctx.drawImage(heartImg, x, y, s, s); }
function flame(cx, cy, s, col, hole) {
