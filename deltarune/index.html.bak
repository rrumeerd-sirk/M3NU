function talkWho() { if (!needTalk()) return; selT.who = ((selT.who | 0) + 1) % 6; saveLayout(); say(selT.who ? &quot;speaker: icon &quot; + selT.who + &quot; (text/icons/&quot; + selT.who + &quot;.png)&quot; : &quot;speaker: none&quot;); }
function talkBattle() { if (!needTalk()) return; selT.battle = ((selT.battle | 0) + 1) % 8; saveLayout(); say(selT.battle ? &quot;starts a battle after talking: &quot; + etype({ type: selT.battle }).name : &quot;no battle&quot;); }
