})});
[[&#x27;mAdd&#x27;,&#x27;add&#x27;],[&#x27;mMove&#x27;,&#x27;move&#x27;],[&#x27;mDel&#x27;,&#x27;del&#x27;]].forEach(function(a){E(a[0]).addEventListener(&#x27;click&#x27;,function(){
  mode=a[1];[&#x27;mAdd&#x27;,&#x27;mMove&#x27;,&#x27;mDel&#x27;].forEach(function(i){E(i).classList.toggle(&#x27;on&#x27;,i===a[0])});
