#plBtn{position:fixed;top:calc(max(8px,env(safe-area-inset-top)) + 80px);left:max(8px,env(safe-area-inset-left));z-index:6;font:inherit;color:#fff;background:rgba(0,0,0,.55);border:2px solid #777;padding:4px 10px;opacity:.75;cursor:pointer;touch-action:manipulation}
#plBtn:hover,#plBtn.on{border-color:#ff0}
#plist{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.65);z-index:10;opacity:0;pointer-events:none}
