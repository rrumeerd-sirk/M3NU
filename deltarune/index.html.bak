#plist button:disabled{opacity:.4;cursor:default}
#plist input[type=text]{flex:1 1 200px;min-width:0;font:inherit;color:#fff;background:#111;border:2px solid #777;padding:3px 6px}
#plist input[type=text]:focus{outline:none;border-color:#ff0}
#shop{position:fixed;inset:0;display:none;background:#000;z-index:10;overflow:hidden;font-family:undertale,&quot;Courier New&quot;,monospace;color:#fff;user-select:none;-webkit-user-select:none}
#shop .st{position:absolute;left:50%;top:50%;width:640px;height:480px;margin:-240px 0 0 -320px;transform-origin:50% 50%;image-rendering:pixelated}
#shop canvas{position:absolute;inset:0;width:640px;height:480px;image-rendering:pixelated}
#shop .bx{position:absolute;background:#000;border:4px solid #fff;box-sizing:border-box;padding:10px 16px;font-size:26px;line-height:1.25}
