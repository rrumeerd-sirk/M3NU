  }
  function sync() {
    if (!list.length || idx &lt; 0 || idx &gt;= list.length || !isFull()) { if (shown !== -2) off(); return; }
    if (shown !== idx) show(idx); else layout();
  }
  function setIdx(i) { idx = i; try { localStorage.setItem(&quot;bpBorder&quot;, String(i)); } catch (e) {} sync(); }
  async function find() {
    try { const r = await fetch(&quot;borders/borders.json&quot;); if (r.ok) { const j = await r.json(); if (Array.isArray(j) &amp;&amp; j.length) return j.map(n =&gt; &quot;borders/&quot; + n); } } catch (e) {}
    const out = [];
    for (let i = 1; i &lt;= 30; i++) { const ok = await new Promise(res =&gt; { const im = new Image(); im.onload = () =&gt; res(true); im.onerror = () =&gt; res(false); im.src = &quot;borders/&quot; + i + &quot;.png&quot;; }); if (!ok) break; out.push(&quot;borders/&quot; + i + &quot;.png&quot;); }
    return out;
  }
  addEventListener(&quot;resize&quot;, sync); document.addEventListener(&quot;fullscreenchange&quot;, sync);
