function plParse(raw) {
  raw = (raw || &quot;&quot;).trim(); if (!raw) return null;
  let v = &quot;&quot;, list = &quot;&quot;;
  if (/^(PL|OLAK5uy_|UU|FL)[\w-]{10,}$/.test(raw)) list = raw;
  else if (/^[\w-]{11}$/.test(raw)) v = raw;
  else {
    let u; try { u = new URL(/^[a-z]+:\/\//i.test(raw) ? raw : &quot;https://&quot; + raw); } catch (e) { return null; }
