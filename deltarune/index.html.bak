];
const etype = e =&gt; ETYPES[clamp((e.type | 0) || 1, 1, 7) - 1];
function loadSet(dir, fb) {
  const mk = (n, c) =&gt; Array.from({ length: c }, (_, i) =&gt; {
    const im = new Image();
    im.onerror = () =&gt; { im.onerror = null; im.src = fb + n + &quot;_&quot; + i + &quot;.png&quot;; };
    im.src = dir + n + &quot;_&quot; + i + &quot;.png&quot;;
    return im;
  });
  return { down: mk(&quot;down&quot;, 4), left: mk(&quot;left&quot;, 2), right: mk(&quot;right&quot;, 2), up: mk(&quot;up&quot;, 4) };
}
const enemySets = ETYPES.map(T =&gt; loadSet(&quot;enemy/&quot; + T.id + &quot;/&quot;, &quot;enemy/&quot;));
const eImgs = e =&gt; enemySets[etype(e).id - 1];
const bodyBox = (x, y) =&gt; ({ x: x + KRIS_HB.body.x, y: y + KRIS_HB.body.y, w: KRIS_HB.body.w, h: KRIS_HB.body.h });
const enemyBox = e =&gt; { const T = etype(e), sw = T.sw || 1, sh = T.sh || 1, ox = e.x + (SPR_W - SPR_W * sw) / 2, oy = e.y + SPR_H - SPR_H * sh; return { x: ox + 2 * sw, y: oy + 8 * sh, w: (SPR_W - 4) * sw, h: (SPR_H - 8) * sh }; };
function patrolPoint(e, i) {
  const p = e.pts[i];
  if (p.id === undefined) return { x: p.x, y: p.y };
  const box = ITEMS.find(b =&gt; b.id === p.id);
  if (!box) return { x: e.x || 0, y: e.y || 0 };
  return { x: p.side &lt; 0 ? box.x - SPR_W - 4 : box.x + IS + 6, y: box.y - 2 };
}
function makeEnemy(a, b, world = 0, type = 1, mus = 0) {
  const e = { pts: [a, b], world, type: clamp((type | 0) || 1, 1, 7), mus: clamp(mus | 0, 0, 7), x: 0, y: 0, chasing: false, dir: &quot;down&quot;, frame: 0, timer: 0, moving: true, wait: 0, to: 1, cool: 0, alive: true };
  Object.assign(e, patrolPoint(e, 0));
  return e;
}
const defaultEnemies = () =&gt; [
  makeEnemy({ id: &quot;up&quot;, side: -1 }, { id: &quot;left&quot;, side: 1 }),
  makeEnemy({ x: 168, y: 162 }, { id: &quot;right&quot;, side: -1 }, 0, 2)
];
const enemies = defaultEnemies();
const liveEnemies = () =&gt; enemies.filter(e =&gt; e.world === worldIdx);
const LINKS = [];
const PUZZLES = [];
const PKINDS = [&quot;spikes&quot;, &quot;door&quot;, &quot;block&quot;], PDIR = [[0, -1], [1, 0], [0, 1], [-1, 0]], PDIRN = [&quot;up&quot;, &quot;right&quot;, &quot;down&quot;, &quot;left&quot;];
const TALKS = [];
const TALK_DEFAULT = &quot;Hey! Don&#x27;t touch that.|...I said don&#x27;t touch it.&quot;;
const liveLinks = () =&gt; LINKS.filter(l =&gt; l.world === worldIdx);
let fighting = null;
function respawnEnemies() {
  for (const e of enemies) {
    if (!e.alive) continue;
    const p0 = patrolPoint(e, 0), p1 = patrolPoint(e, 1);
    const far = Math.hypot(p0.x - player.x, p0.y - player.y) &gt; Math.hypot(p1.x - player.x, p1.y - player.y) ? 0 : 1;
    Object.assign(e, patrolPoint(e, far));
    e.to = 1 - far; e.wait = 30; e.cool = 90;
  }
}
function updateEnemy(e) {
  const T = etype(e);
  if (e.cool &gt; 0) e.cool--;
  if (T.chase &amp;&amp; e.cool &lt;= 0 &amp;&amp; !dlg) {
    const vx = player.x - e.x, vy = player.y - e.y, d = Math.hypot(vx, vy);
    e.chasing = d &lt; T.chase * (e.chasing ? 1.4 : 1);
    if (e.chasing &amp;&amp; d &gt; 0.5) {
      const s = Math.min(T.chaseSpeed, d), nx = e.x + vx / d * s, ny = e.y + vy / d * s;
      if (inWorld(nx, ny)) { e.x = nx; e.y = ny; }
      e.dir = Math.abs(vx) &gt; Math.abs(vy) ? (vx &lt; 0 ? &quot;left&quot; : &quot;right&quot;) : (vy &lt; 0 ? &quot;up&quot; : &quot;down&quot;);
      e.moving = true; e.wait = 0;
      if (++e.timer &gt;= 6) { e.frame++; e.timer = 0; }
      e.frame %= eImgs(e)[e.dir].length;
      return;
    }
  }
  if (e.wait &gt; 0) { e.wait--; e.moving = false; e.frame = 0; return; }
  const t = patrolPoint(e, e.to), vx = t.x - e.x, vy = t.y - e.y, d = Math.hypot(vx, vy);
  if (d &lt;= T.speed) {
    e.x = t.x; e.y = t.y; e.to = 1 - e.to; e.wait = 60; e.moving = false; e.frame = 0;
    return;
  }
  e.x += vx / d * T.speed; e.y += vy / d * T.speed;
  e.dir = Math.abs(vx) &gt; Math.abs(vy) ? (vx &lt; 0 ? &quot;left&quot; : &quot;right&quot;) : (vy &lt; 0 ? &quot;up&quot; : &quot;down&quot;);
  e.moving = true;
  if (++e.timer &gt;= 10) { e.frame++; e.timer = 0; }
  e.frame %= eImgs(e)[e.dir].length;
}

const LIMIT = 100000;
const MAX_ROOM = 60000;
const WALL_H = 44;
const R = (x, y, w, h, c) =&gt; { ctx.fillStyle = c; ctx.fillRect(Math.round(x * SCALE), Math.round(y * SCALE), w * SCALE, h * SCALE); };

const STYLES = {
  dark: { label: &quot;dark&quot;, wall: [&quot;#2a3250&quot;, &quot;#1d2338&quot;, &quot;#252d47&quot;], floor(a) { R(a.x, a.y, a.w, a.h, &quot;#111&quot;); } },
  wood: { label: &quot;wood&quot;, wall: [&quot;#3b4670&quot;, &quot;#2a3250&quot;, &quot;#344063&quot;], floor(a, y0) {
    R(a.x, a.y, a.w, a.h, &quot;#7a5230&quot;);
    const bottom = a.y + a.h;
    for (let y = y0, r = 0; y &lt; bottom; y += 14, r++) {
      R(a.x, y, a.w, 1, &quot;#5f3f24&quot;);
      for (let x = a.x + (r % 2 ? 0 : 20); x &lt; a.x + a.w; x += 40) R(x, y, 1, Math.min(14, bottom - y), &quot;#5f3f24&quot;);
    }
  } },
  stone: { label: &quot;stone&quot;, wall: [&quot;#4a4a58&quot;, &quot;#34343f&quot;, &quot;#42424f&quot;], floor(a, y0) {
    R(a.x, a.y, a.w, a.h, &quot;#2c2c36&quot;);
    const bottom = a.y + a.h;
    for (let y = y0, r = 0; y &lt; bottom; y += 20, r++) {
      R(a.x, y, a.w, 1, &quot;#20202a&quot;);
      for (let x = a.x + (r % 2 ? 0 : 10); x &lt; a.x + a.w; x += 20) R(x, y, 1, Math.min(20, bottom - y), &quot;#20202a&quot;);
    }
  } },
  carpet: { label: &quot;carpet&quot;, wall: [&quot;#4a3a74&quot;, &quot;#33274f&quot;, &quot;#43346a&quot;], floor(a, y0) {
    R(a.x, a.y, a.w, a.h, &quot;#3a2a5c&quot;);
    for (let y = y0; y &lt; a.y + a.h; y += 8) R(a.x, y, a.w, 1, &quot;#43326a&quot;);
  } },
  grass: { label: &quot;grass&quot;, wall: [&quot;#3a5a8a&quot;, &quot;#2a4268&quot;, &quot;#35527e&quot;], floor(a) {
    R(a.x, a.y, a.w, a.h, &quot;#2f6b3a&quot;);
    for (let y = a.y, j = 0; y &lt; a.y + a.h - 2; y += 12, j++) for (let x = a.x, i = 0; x &lt; a.x + a.w - 2; x += 12, i++) {
      const h = (i * 7 + j * 13) % 12; R(x + h % 8, y + (h * 5) % 9, 2, 2, &quot;#3a7d46&quot;);
    }
  } },
  field: { label: &quot;field&quot;, wall: [&quot;#1b1450&quot;, &quot;#120d38&quot;, &quot;#17104a&quot;], floor(a) {
    const TS = 20;
    R(a.x, a.y, a.w, a.h, &quot;#241a66&quot;);
    const anim = GRASS_FRAMES.every(t =&gt; t.complete &amp;&amp; t.naturalWidth);
    if (!anim &amp;&amp; !FIELD_TILES.every(t =&gt; t.complete &amp;&amp; t.naturalWidth)) return;
    const vx0 = cam() - TS, vx1 = cam() + BASE_W / zoom(), vy0 = camY() - TS, vy1 = camY() + BASE_H / zoom();
    for (let j = 0, y = a.y; y &lt; a.y + a.h; y += TS, j++) {
      if (y &gt; vy1 || y + TS &lt; vy0) continue;
      for (let i = 0, x = a.x; x &lt; a.x + a.w; x += TS, i++) {
        if (x &gt; vx1 || x + TS &lt; vx0) continue;
        let n = (Math.imul(i + 1, 73856093) ^ Math.imul(j + 1, 19349663)) &gt;&gt;&gt; 0; n = (n ^ (n &gt;&gt;&gt; 13)) &gt;&gt;&gt; 0;
        const sw = Math.min(TS, a.x + a.w - x), sh = Math.min(TS, a.y + a.h - y);
        const img = anim ? GRASS_FRAMES[((fr / GRASS_TICKS | 0) + (GRASS_SYNC ? 0 : n)) % 9] : FIELD_TILES[n % 9];
        ctx.drawImage(img, 0, 0, sw * 2, sh * 2, Math.round(x * SCALE), Math.round(y * SCALE), sw * SCALE, sh * SCALE);
      }
    }
  } }
};
const FIELD_TILES = [
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;,
  &quot;data:image/png;base64,&quot;
].map(load);
const GRASS_TICKS = 10, GRASS_SYNC = false;
const GRASS_FRAMES = [0, 1, 2, 3, 4, 5, 6, 7, 8].map(i =&gt; load(&quot;items/grass/spr_tile_darkgrass_middle_&quot; + i + &quot;.png&quot;));
const FLOOR_SNAP = { wood: [40, 28], stone: [20, 40], carpet: [8, 8], grass: [144, 144] };
function drawArea(a) {
  const vx0 = cam() - 40, vx1 = cam() + BASE_W / zoom() + 40, vy0 = camY() - 40, vy1 = camY() + BASE_H / zoom() + 40;
  if (a.x &gt; vx1 || a.x + a.w &lt; vx0 || a.y &gt; vy1 || a.y + a.h &lt; vy0) return;
  const st = STYLES[a.style] || STYLES.dark, wh = a.wall ? Math.min(WALL_H, a.h) : 0, y0 = a.y + wh;
  let v = a, vy = y0;
  if (a.style !== &quot;field&quot;) {
    const [sx, sy] = FLOOR_SNAP[a.style] || [1, 1];
    const x1 = a.x + Math.floor(Math.max(0, vx0 - a.x) / sx) * sx, x2 = Math.min(a.x + a.w, vx1);
    let y1 = a.y; vy = y0;
    if (vy0 &gt; y0) { y1 = y0 + Math.floor((vy0 - y0) / sy) * sy; vy = y1; }
    const y2 = Math.min(a.y + a.h, vy1);
    v = { x: x1, y: y1, w: x2 - x1, h: y2 - y1 };
  }
  st.floor(v, vy);
  if (wh) {
    const wx1 = Math.max(a.x, vx0), wx2 = Math.min(a.x + a.w, vx1);
    R(wx1, a.y, wx2 - wx1, wh, st.wall[0]); R(wx1, a.y + wh - 6, wx2 - wx1, 6, st.wall[1]);
    for (let x = a.x + 10 + Math.floor(Math.max(0, vx0 - a.x - 10) / 28) * 28; x &lt; wx2; x += 28) R(x, a.y, 1, wh - 6, st.wall[2]);
  }
}

