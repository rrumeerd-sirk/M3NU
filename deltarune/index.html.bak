&lt;b&gt;12&lt;/b&gt;
&lt;div&gt;12&lt;/div&gt;
&lt;/div&gt;&lt;div class=&quot;row&quot;&gt;&lt;button id=&quot;hDone&quot;&gt;12&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;
&lt;div id=&quot;tut&quot; style=&quot;display:none;position:fixed;inset:0;z-index:50;background:#0b1117cc;align-items:center;justify-content:center;color:#fff;font-family:system-ui,sans-serif;pointer-events:none&quot;&gt;&lt;div id=&quot;cd&quot; style=&quot;font-size:clamp(90px,30vw,220px);font-weight:900;text-shadow:3px 3px 0 #000&quot;&gt;3&lt;/div&gt;&lt;/div&gt;
&lt;div id=&quot;overlay&quot;&gt;&lt;h1 id=&quot;ttl&quot;&gt;12&lt;/h1&gt;
&lt;p id=&quot;msg&quot;&gt;12&lt;/p&gt;
&lt;p&gt;12&lt;br&gt;12&lt;/p&gt;
&lt;div&gt;&lt;label class=&quot;pick&quot;&gt;12&lt;input type=&quot;file&quot; id=&quot;sprites&quot; accept=&quot;image/*&quot; multiple hidden&gt;&lt;/label&gt;&lt;label class=&quot;pick&quot; id=&quot;clr&quot;&gt;12&lt;/label&gt;&lt;/div&gt;
&lt;div&gt;&lt;label class=&quot;pick&quot;&gt;Kris sprites&lt;input type=&quot;file&quot; id=&quot;ksprites&quot; accept=&quot;image/*&quot; multiple hidden&gt;&lt;/label&gt;&lt;label class=&quot;pick&quot;&gt;Shooter sprites&lt;input type=&quot;file&quot; id=&quot;esprites&quot; accept=&quot;image/*&quot; multiple hidden&gt;&lt;/label&gt;&lt;/div&gt;
&lt;p id=&quot;sprInfo&quot;&gt;12&lt;/p&gt;
&lt;div&gt;&lt;label class=&quot;pick&quot;&gt;12&lt;input type=&quot;file&quot; id=&quot;emodel&quot; accept=&quot;.glb&quot; hidden&gt;&lt;/label&gt;&lt;label class=&quot;pick&quot;&gt;12&lt;input type=&quot;file&quot; id=&quot;omodel&quot; accept=&quot;.glb&quot; hidden&gt;&lt;/label&gt;&lt;label class=&quot;pick&quot;&gt;12&lt;input type=&quot;file&quot; id=&quot;pmodel&quot; accept=&quot;.glb&quot; hidden&gt;&lt;/label&gt;&lt;/div&gt;
&lt;div&gt;&lt;label class=&quot;pick&quot; id=&quot;oBtn&quot;&gt;12&lt;/label&gt;&lt;label class=&quot;pick&quot; id=&quot;gBtn&quot;&gt;12&lt;/label&gt;&lt;label class=&quot;pick&quot; id=&quot;hBtn&quot;&gt;12&lt;/label&gt;&lt;/div&gt;
&lt;p&gt;12&lt;/p&gt;
&lt;b id=&quot;go&quot;&gt;12&lt;/b&gt;&lt;/div&gt;
&lt;script src=&quot;https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js&quot;&gt;&lt;/script&gt;
&lt;script src=&quot;https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js&quot;&gt;&lt;/script&gt;
&lt;script&gt;
(function(){
var isTouch=(&#x27;ontouchstart&#x27; in window)||navigator.maxTouchPoints&gt;0;
var renderer=new THREE.WebGLRenderer({antialias:false,powerPreference:&#x27;high-performance&#x27;});
var pr=Math.min(devicePixelRatio,1.5),prMax=pr,fAcc=0,fN=0;
renderer.setPixelRatio(pr);
function adapt(rawDt){
  if(rawDt&gt;0.25)return;
  fAcc+=rawDt;fN++;if(fN&lt;40)return;
  var avg=fAcc/fN,np=pr;fAcc=0;fN=0;
  if(avg&gt;0.021&amp;&amp;pr&gt;0.45)np=Math.max(0.45,pr-0.2);
  else if(avg&lt;0.012&amp;&amp;pr&lt;prMax)np=Math.min(prMax,pr+0.1);
  if(np!==pr){pr=np;renderer.setPixelRatio(pr);renderer.setSize(innerWidth,innerHeight)}
}
renderer.setSize(innerWidth,innerHeight);
document.body.appendChild(renderer.domElement);
var cv=renderer.domElement;
var scene=new THREE.Scene();
scene.background=new THREE.Color(0x9ad0ec);
scene.fog=new THREE.Fog(0x9ad0ec,40,150);
var camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,0.1,300);
camera.rotation.order=&#x27;YXZ&#x27;;
camera.position.set(0,1.6,0);
scene.add(camera);
var hemi=new THREE.HemisphereLight(0xffffff,0x667788,0.9);
scene.add(hemi);
var sun=new THREE.DirectionalLight(0xffffff,0.7);
sun.position.set(30,60,20);
scene.add(sun);

var plate=new THREE.Mesh(new THREE.PlaneGeometry(200,200),new THREE.MeshLambertMaterial({color:0x6f757d}));
plate.rotation.x=-Math.PI/2;
scene.add(plate);
var grid=new THREE.GridHelper(200,100,0x444a52,0x565d66);
grid.position.y=0.02;
scene.add(grid);
var LIM=98;

var dayT=0.3,lastTm=&#x27;&#x27;;
var lamp=new THREE.SpotLight(0xfff2cc,0,60,0.5,0.5,1),lt=new THREE.Object3D();
lamp.position.set(0.2,-0.1,0);lt.position.set(0,0,-5);camera.add(lamp,lt);lamp.target=lt;
var sg=new THREE.BufferGeometry(),spts=[];
for(var si=0;si&lt;350;si++){var su=Math.random()*6.283,sv=Math.random()*1.4+0.1;spts.push(Math.cos(su)*Math.cos(sv)*240,Math.sin(sv)*240,Math.sin(su)*Math.cos(sv)*240)}
sg.setAttribute(&#x27;position&#x27;,new THREE.Float32BufferAttribute(spts,3));
var stars=new THREE.Points(sg,new THREE.PointsMaterial({color:0xffffff,size:2,sizeAttenuation:false,transparent:true,fog:false,depthWrite:false}));
scene.add(stars);
var cDay=new THREE.Color(0x9ad0ec),cNight=new THREE.Color(0x070b1c),cDusk=new THREE.Color(0xf08a5d),cTmp=new THREE.Color();
function applyTime(){
  var a=(dayT-0.25)*Math.PI*2,el=Math.sin(a),k=Math.max(0,Math.min(1,(el+0.15)/0.45));
  cTmp.copy(cNight).lerp(cDay,k).lerp(cDusk,Math.max(0,1-Math.abs(el)/0.3)*0.55);
  scene.background.copy(cTmp);scene.fog.color.copy(cTmp);
  hemi.intensity=0.22+0.7*k;sun.intensity=0.2+0.55*k;sun.color.setHex(k&gt;0.5?0xffffff:0x9fb4ff);
  sun.position.set(Math.cos(a)*60,Math.abs(el)*60+8,20);
  lamp.intensity=(1-k)*1.4;stars.material.opacity=1-k;stars.visible=k&lt;0.95;
  var h=dayT*24,txt=(k&gt;0.5?&#x27;Day &#x27;:&#x27;Night &#x27;)+(&#x27;0&#x27;+Math.floor(h)).slice(-2)+&#x27;:&#x27;+(&#x27;0&#x27;+Math.floor((h%1)*60)).slice(-2);
  if(txt!==lastTm){E(&#x27;tm&#x27;).textContent=txt;lastTm=txt}
}
function skipTime(){dayT=Math.sin((dayT-0.25)*Math.PI*2)&gt;0.1?0.8:0.3;applyTime()}
applyTime();

var gun=new THREE.Group();
var gm=new THREE.MeshLambertMaterial({color:0x2b2f36});
var body=new THREE.Mesh(new THREE.BoxGeometry(0.12,0.15,0.5),gm);
var barrel=new THREE.Mesh(new THREE.BoxGeometry(0.05,0.05,0.35),new THREE.MeshLambertMaterial({color:0x555c66}));
barrel.position.set(0,0.04,-0.4);
var flash=new THREE.Mesh(new THREE.BoxGeometry(0.1,0.1,0.1),new THREE.MeshBasicMaterial({color:0xffdd55}));
flash.position.set(0,0.04,-0.62);
flash.visible=false;
gun.add(body,barrel,flash);
gun.position.set(0.28,-0.26,-0.55);
camera.add(gun);
var W=[
  {name:&#x27;pistool&#x27;,body:&#x27;#2b2f36&#x27;,barrel:&#x27;#555c66&#x27;,len:0.25,size:0.9,rate:4,dmg:1,pellets:1,spread:0,mag:12,reload:1.1},
  {name:&#x27;Rifle&#x27;,body:&#x27;#3a4a2f&#x27;,barrel:&#x27;#222222&#x27;,len:0.5,size:1.1,rate:8,dmg:1,pellets:1,spread:0.01,mag:30,reload:1.6},
  {name:&#x27;Shotgun&#x27;,body:&#x27;#6b4a2b&#x27;,barrel:&#x27;#444444&#x27;,len:0.4,size:1.15,rate:1.2,dmg:1,pellets:7,spread:0.07,mag:6,reload:2.2},
  {name:&#x27;Sniper&#x27;,body:&#x27;#1f2a3a&#x27;,barrel:&#x27;#111111&#x27;,len:0.85,size:1.2,rate:1,dmg:4,pellets:1,spread:0,mag:5,reload:2.4},
  {name:&#x27;SMG&#x27;,body:&#x27;#5a2b6b&#x27;,barrel:&#x27;#333333&#x27;,len:0.3,size:0.85,rate:14,dmg:1,pellets:1,spread:0.03,mag:40,reload:1.4}
],G=W[0];
W.forEach(function(w){w.ammo=w.mag});
function applyGun(){
  gm.color.set(G.body);barrel.material.color.set(G.barrel);
  barrel.geometry.dispose();barrel.geometry=new THREE.BoxGeometry(0.05,0.05,G.len);
  barrel.position.z=-0.225-G.len/2;flash.position.z=-0.27-G.len;gun.scale.setScalar(G.size);
  G.ammo=Math.min(G.ammo,G.mag);updAmmo();
}
var avatar=new THREE.Group();
function av(w,h,d,c,x,y,z){var m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshLambertMaterial({color:c}));m.position.set(x,y,z);avatar.add(m)}
av(0.6,0.6,0.4,0x2c3e6b,0,0.3,0);av(0.8,0.8,0.45,0x3b7dd8,0,1.0,0);av(0.5,0.5,0.5,0xf2c27a,0,1.65,0);av(0.12,0.15,0.5,0x2b2f36,0.5,1.05,-0.3);
avatar.visible=false;scene.add(avatar);

var state=&#x27;menu&#x27;,yaw=0,pitch=0,vy=0,ground=true,hp=100,score=0;
var sprintHeld=false,sprintId=null,thirdP=false,view2d=false,fov=75,sprites=[],enemyModel=null,obstacles=[],obsMeshes=[],reloadT=0,wi=0,sprintOn=false,heals=[],healT=6;
var fireHeld=false,cool=0,recoil=0,flashT=0,spawnT=0,hurtCd=0;
var keys={},enemies=[];

var lcx=-1,lcy=-1,VIEWH=12,cam2=new THREE.OrthographicCamera(-20,20,VIEWH,-VIEWH,0.1,400);
var cur2={x:innerWidth/2,y:innerHeight/2},cursorOn=false,crossEl=document.getElementById(&#x27;cross&#x27;);
function ppu2(){return innerHeight/(VIEWH*2)}
function pivot2(){return{x:innerWidth/2,y:innerHeight/2-0.95*ppu2()}}
function setView(v){
  thirdP=v&gt;=1;var was=view2d;view2d=v===2;
  if(view2d&amp;&amp;!was){var pv=pivot2(),p=ppu2();cur2.x=pv.x-Math.sin(yaw)*p*5;cur2.y=pv.y-Math.cos(yaw)*p*5;cursorOn=!isTouch&amp;&amp;document.pointerLockElement===cv}
  if(!view2d&amp;&amp;was){cursorOn=false;crossEl.style.left=&#x27;&#x27;;crossEl.style.top=&#x27;&#x27;}
}
