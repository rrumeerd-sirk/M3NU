<iframe id="g3" srcdoc="&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;&lt;head&gt;&lt;meta charset=&quot;utf-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1, viewport-fit=cover&quot;&gt;
&lt;title&gt;Mini-games&lt;/title&gt;
&lt;style&gt;html,body{height:100%;margin:0;background:#000;overflow:hidden;touch-action:none;font-family:&quot;Courier New&quot;,monospace}
body{display:flex;align-items:center;justify-content:center}
canvas{max-width:100%;max-height:100%;aspect-ratio:480/640;background:#000;border:4px solid #fff}&lt;/style&gt;&lt;/head&gt;
&lt;body&gt;&lt;canvas id=&quot;c&quot; width=&quot;480&quot; height=&quot;640&quot;&gt;&lt;/canvas&gt;
&lt;script&gt;
const c=document.getElementById(&#x27;c&#x27;),g=c.getContext(&#x27;2d&#x27;),W=480,H=640,GAMES=[&#x27;CATCH&#x27;];
let cdAt=0,st=&#x27;idle&#x27;,sel=0,sc=0,t0=0,endAt=0,px=W/2,items=[],nx=0,keys={},round=0,msg=&#x27;&#x27;,msgAt=0,last=0;
const T=(s,x,y,z,col)=&gt;{g.font=&#x27;bold &#x27;+z+&#x27;px &quot;Courier New&quot;,monospace&#x27;;g.textAlign=&#x27;center&#x27;;g.fillStyle=col||&#x27;#fff&#x27;;g.fillText(s,x,y)};
function begin(m){st=m;sc=0;t0=performance.now();items=[];nx=0;round=0;msg=&#x27;&#x27;;px=W/2;last=t0}
function finish(){st=&#x27;end&#x27;;endAt=performance.now()}
function hit(){if(st===&#x27;menu&#x27;)begin(&#x27;catch&#x27;)}
addEventListener(&#x27;keydown&#x27;,e=&gt;{
  const k=e.key.toLowerCase();keys[k]=1;
  if([&#x27;arrowup&#x27;,&#x27;arrowdown&#x27;,&#x27;arrowleft&#x27;,&#x27;arrowright&#x27;,&#x27; &#x27;].includes(k))e.preventDefault();
  if(st===&#x27;menu&#x27;){if(k===&#x27;arrowup&#x27;||k===&#x27;w&#x27;)sel=(sel+GAMES.length-1)%GAMES.length;
    else if(k===&#x27;arrowdown&#x27;||k===&#x27;s&#x27;)sel=(sel+1)%GAMES.length;
    else if(k===&#x27;1&#x27;||k===&#x27;enter&#x27;||k===&#x27; &#x27;)hit()}
});
addEventListener(&#x27;keyup&#x27;,e=&gt;{keys[e.key.toLowerCase()]=0});
function pos(e){const r=c.getBoundingClientRect();return{x:(e.clientX-r.left)/r.width*W,y:(e.clientY-r.top)/r.height*H}}
c.addEventListener(&#x27;pointerdown&#x27;,e=&gt;{const p=pos(e);
  if(st===&#x27;menu&#x27;){hit()}
  else if(st===&#x27;catch&#x27;)px=p.x});
c.addEventListener(&#x27;pointermove&#x27;,e=&gt;{if(st===&#x27;catch&#x27;&amp;&amp;e.buttons)px=pos(e).x});
function frame(now){
  g.fillStyle=&#x27;#000&#x27;;g.fillRect(0,0,W,H);
  if(st===&#x27;count&#x27;){
    const el=(performance.now()-cdAt)/1000;
    T(String(Math.max(1,Math.ceil(3-el))),W/2,H/2+50,150);
    if(el&gt;=3)begin(&#x27;catch&#x27;);
  }
  if(st===&#x27;catch&#x27;){
    const dt=Math.min(.05,(now-last)/1000);last=now;const el=(now-t0)/1000,left=20-el;
    if(keys.arrowleft||keys.a)px-=320*dt;if(keys.arrowright||keys.d)px+=320*dt;px=Math.max(40,Math.min(W-40,px));
    nx-=dt;if(nx&lt;=0){nx=.45;items.push({x:20+Math.random()*(W-40),y:-10,bad:Math.random()&lt;.3})}
    for(const o of items){o.y+=(200+el*12)*dt;
      if(!o.done&amp;&amp;o.y&gt;H-80&amp;&amp;o.y&lt;H-40&amp;&amp;Math.abs(o.x-px)&lt;48){o.done=1;sc+=o.bad?-1:1}
      g.fillStyle=o.bad?&#x27;#ff4455&#x27;:&#x27;#ffe94f&#x27;;g.beginPath();g.arc(o.x,o.y,10,0,7);g.fill()}
    items=items.filter(o=&gt;!o.done&amp;&amp;o.y&lt;H+20);
    g.fillStyle=&#x27;#fff&#x27;;g.fillRect(px-40,H-60,80,12);
    T(&#x27;SCORE &#x27;+sc,W/2,40,22);T(&#x27;TIME &#x27;+Math.max(0,Math.ceil(left)),W-70,40,18);
    if(left&lt;=0)finish();
  }
  if(st===&#x27;end&#x27;){
    T(&#x27;DONE!&#x27;,W/2,280,48,&#x27;#ffe94f&#x27;);T(&#x27;SCORE &#x27;+sc,W/2,340,28);
    if(now-endAt&gt;1800){st=&#x27;idle&#x27;;parent.postMessage(&#x27;miniDone&#x27;,&#x27;*&#x27;)}
  }
  requestAnimationFrame(frame);
}
addEventListener(&#x27;message&#x27;,e=&gt;{if(e.data&amp;&amp;e.data.type===&#x27;miniStart&#x27;){sel=0;st=&#x27;count&#x27;;cdAt=performance.now();focus()}});
requestAnimationFrame(frame);
&lt;/script&gt;&lt;/body&gt;&lt;/html&gt;
" style="display:none"></iframe>
<script>
var cur=1,rhy=false,mini=false,arena=null,tEl=document.getElementById('tm'),fr=['g0','g1','g2','g3'].map(function(i){return document.getElementById(i)});
function show(i){cur=i;fr.forEach(function(f,k){if(f)f.style.display=k===i?'block':'none'});if(fr[i]&&fr[i].contentWindow)fr[i].contentWindow.focus()}
function tick(){
  var l=Math.ceil((arena.end-Date.now())/1000);
  tEl.textContent=Math.max(0,l);
  if(l<=0)endArena();
}
function startArena(secs){
  if(arena)return;
  arena={secs:secs,end:0};
  show(0);
  fr[0].contentWindow.postMessage({type:'arenaStart'},'*');
}
function goArena(){
  if(!arena||arena.iv)return;
  arena.end=Date.now()+arena.secs*1000;tEl.style.display='block';
  arena.iv=setInterval(tick,100);tick();
}
function endArena(){
  clearInterval(arena.iv);arena=null;tEl.style.display='none';
  fr[0].contentWindow.postMessage({type:'arenaEnd'},'*');
  show(1);fr[1].contentWindow.postMessage('arenaDone','*');
}
addEventListener('message',function(e){
  if(e.data==='arenaGo')goArena();
  else if(e.data&&e.data.type==='arena')startArena(e.data.secs||30);
  else if(e.data&&e.data.type==='rhythm'){rhy=true;show(2);fr[2].contentWindow.postMessage({type:'rhythmStart'},'*')}
  else if(e.data==='rhythmDone'&&rhy){rhy=false;show(1);fr[1].contentWindow.postMessage('arenaDone','*')}
  else if(e.data&&e.data.type==='mini'){mini=true;show(3);fr[3].contentWindow.postMessage({type:'miniStart'},'*')}
  else if(e.data==='miniDone'&&mini){mini=false;show(1);fr[1].contentWindow.postMessage('arenaDone','*')}
  else if(e.data==='arenaDead'&&arena){clearInterval(arena.iv);arena=null;tEl.style.display='none';fr[1].contentWindow.postMessage('arenaDead','*')}
  else if(e.data==='arenaContinue'){fr[0].contentWindow.postMessage({type:'arenaEnd'},'*');show(1);fr[1].contentWindow.postMessage('arenaLost','*')}
});
fr[1].addEventListener('load',function(){if(cur===1)fr[1].contentWindow.focus()});
show(1);
addEventListener('load',function(){if(!arena&&!rhy&&!mini)show(1)});
</script></body></html>
