E(&#x27;oBtn&#x27;).addEventListener(&#x27;click&#x27;,function(){openEd(&#x27;edit&#x27;)});
E(&#x27;gBtn&#x27;).addEventListener(&#x27;click&#x27;,function(){openEd(&#x27;gun&#x27;)});
